---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NanoStage from '../components/NanoStage.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedBlogPosts, postSlug } from '../lib/blog';

const latestPosts = (await getPublishedBlogPosts()).slice(0, 5);

const overviewSpecs = [
	{ label: 'ROLE', value: '共同創業者 / NanoFrontier' },
	{ label: 'BASE', value: 'Tokyo / Sendai' },
	{ label: 'PREVIOUS', value: 'Catalis Partners Group' },
	{ label: 'ENGINEERING', value: 'DeNA / Anyca (iOS · Android · Server · PdM)' },
	{ label: 'EDUCATION', value: '鳥取大学 工学部' },
	{ label: 'FOCUS', value: 'Nanoparticles · Energy · Software' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/profile_image.jpg" />
	</head>
	<body>
		<NanoStage variant="home" />
		<Header />

		<main class="sx-home">
			<!-- SECTION 01: FULL-BLEED HERO -->
			<section class="sx-panel sx-panel--hero" aria-label="ヒーロー">
				<div class="sx-block rise">
					<p class="sx-overline">KATSUYA SAITO // CO-FOUNDER @ NANOFRONTIER</p>
					<h1 class="jp-headline">思考を掃き溜めて、<br />次の社会実装へ。</h1>
					<p class="sx-sub">
						ナノ粒子、エネルギー、プロダクト、日々の違和感をそのまま残していく個人アーカイブ。
					</p>
					<a class="sx-btn" href="/blog">READ JOURNAL</a>
				</div>

				<a class="sx-scroll-cue" href="#mission" aria-label="次のセクションへスクロール">
					<svg width="30" height="20" viewBox="0 0 30 20" fill="none" aria-hidden="true">
						<path d="M2 2L15 15L28 2" stroke="#FFFFFF" stroke-width="2" />
					</svg>
				</a>
			</section>

			<!-- SECTION 02: NANOFRONTIER -->
			<section id="mission" class="sx-panel" aria-labelledby="mission-heading">
				<div class="sx-block">
					<p class="sx-overline">CURRENT MISSION // 2025 — PRESENT</p>
					<h2 id="mission-heading" class="en-headline">NANOFRONTIER</h2>
					<p class="sx-sub">
						東北大学発の独自ナノ粒子化技術で、水中PFASのリアルタイム検出・次世代蓄電池・高効率冷却の社会実装に挑む。誰もが手にできる低コストな技術で、資源がなめらかに循環する基盤をつくる。
					</p>
					<a class="sx-btn" href={PROFILE.companyUrl} target="_blank" rel="noopener noreferrer">
						LEARN MORE
					</a>
				</div>
			</section>

			<!-- SECTION 03: OVERVIEW SPECS (AUTHENTIC SPACEX SPEC TABLE) -->
			<section class="sx-panel sx-panel--overview" aria-labelledby="overview-heading">
				<div class="sx-overview-col">
					<p class="sx-overline">KATSUYA SAITO</p>
					<h2 id="overview-heading" class="en-headline">OVERVIEW</h2>

					<dl class="sx-spec-table">
						{overviewSpecs.map((row) => (
							<div class="sx-spec-row">
								<dt>{row.label}</dt>
								<dd>{row.value}</dd>
							</div>
						))}
					</dl>

					<a class="sx-btn" href="/about">ABOUT ME</a>
				</div>
			</section>

			<!-- SECTION 04: JOURNAL ARCHIVE -->
			<section class="sx-journal-section" aria-labelledby="journal-heading">
				<div class="sx-journal-head">
					<div>
						<p class="sx-overline">PERSONAL ARCHIVE</p>
						<h2 id="journal-heading" class="en-headline">JOURNAL</h2>
					</div>
					<a class="sx-btn" href="/blog">ALL POSTS</a>
				</div>

				<div class="sx-post-list">
					{latestPosts.map((post) => {
						const slug = postSlug(post);
						return (
							<article class="sx-post-item">
								<a href={`/blog/${slug}`} class="sx-post-link">
									<span class="sx-post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<div class="sx-post-main">
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									<span class="sx-post-cta">READ</span>
								</a>
							</article>
						);
					})}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.sx-home {
		width: min(var(--container), calc(100% - 64px));
		margin: 0 auto;
		padding: 0 0 110px !important;
	}

	.rise {
		animation: sx-fade-up 900ms var(--ease-sx) both;
	}

	/* Authentic spacex.com Full-Screen 100svh Stacked Sections */
	.sx-panel {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		padding: 96px 0 clamp(3.2rem, 9vh, 6rem);
	}

	.sx-panel--overview {
		align-items: center;
		padding: 110px 0;
	}

	.sx-block {
		max-width: 540px;
	}

	.jp-headline {
		margin: 0 0 1.15rem;
		font-family: var(--font-body);
		font-size: clamp(2.15rem, 4.2vw, 3.35rem);
		font-weight: 900;
		line-height: 1.24;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.en-headline {
		margin: 0 0 1.15rem;
		font-family: var(--font-sx);
		font-size: clamp(2.8rem, 5.6vw, 4.4rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #ffffff;
	}

	.sx-sub {
		max-width: 490px;
		margin: 0 0 2rem;
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.96rem;
		line-height: 1.8;
	}

	.sx-scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 28px;
		transform: translateX(-50%);
		padding: 8px;
		animation: sx-chevron 2.4s ease-in-out infinite;
	}

	/* Authentic SpaceX Vehicle Overview Table */
	.sx-overview-col {
		width: min(540px, 100%);
	}

	.sx-spec-table {
		margin: 1.6rem 0 2.4rem;
		border-top: 1px solid var(--line);
	}

	.sx-spec-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.05rem 0;
		border-bottom: 1px solid var(--line);
	}

	.sx-spec-row dt {
		flex-shrink: 0;
		color: #ffffff;
		font-family: var(--font-sx);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.sx-spec-row dd {
		margin: 0;
		text-align: right;
		color: var(--ink-soft);
		font-size: 0.92rem;
		font-weight: 500;
	}

	/* SpaceX Minimal Journal List */
	.sx-journal-section {
		padding-top: clamp(4rem, 8vw, 7rem);
	}

	.sx-journal-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.sx-journal-head .en-headline {
		margin-bottom: 0;
	}

	.sx-post-list {
		border-top: 1px solid var(--line);
		background: rgba(0, 0, 0, 0.72);
		backdrop-filter: blur(8px);
	}

	.sx-post-item {
		border-bottom: 1px solid var(--line-subtle);
	}

	.sx-post-link {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1.65rem 0;
		text-decoration: none;
	}

	.sx-post-date {
		color: var(--muted);
		font-family: var(--font-sx);
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.sx-post-main h3 {
		margin: 0 0 0.35rem;
		font-family: var(--font-body);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		transition: opacity 180ms ease;
	}

	.sx-post-main p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.sx-post-cta {
		padding: 0.55rem 1.2rem;
		border: 1px solid rgba(255, 255, 255, 0.38);
		color: #ffffff;
		font-family: var(--font-sx);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		transition:
			background 220ms var(--ease-sx),
			color 220ms var(--ease-sx),
			border-color 220ms var(--ease-sx);
	}

	.sx-post-link:hover .sx-post-cta {
		background: #ffffff;
		border-color: #ffffff;
		color: #000000;
	}

	@media (max-width: 860px) {
		.sx-home {
			width: calc(100% - 36px);
		}

		.sx-panel--hero {
			padding-top: 290px;
			padding-bottom: 4.5rem;
		}

		.sx-panel {
			min-height: 92svh;
		}

		.sx-spec-row {
			flex-direction: column;
			gap: 0.25rem;
		}

		.sx-spec-row dd {
			text-align: left;
		}

		.sx-post-link {
			grid-template-columns: 1fr;
			gap: 0.45rem;
		}

		.sx-post-cta {
			display: none;
		}
	}
</style>
