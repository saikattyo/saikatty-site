---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Journal' },
	{ href: '/about', label: 'About' },
];
---

<header class="site-header">
	<nav class="nav-shell" aria-label="メインナビゲーション">
		<a class="brand" href="/" aria-label="Saikattyo ホーム">
			<span class="brand-mark" aria-hidden="true"></span>
			<span class="brand-text">Saikattyo</span>
		</a>
		<div class="nav-links">
			{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		padding: 16px 20px 0;
	}

	.nav-shell {
		width: min(var(--container), 100%);
		margin: 0 auto;
		padding: 10px 10px 10px 16px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid rgba(16, 24, 32, 0.08);
		border-radius: 999px;
		background: rgba(247, 249, 251, 0.72);
		box-shadow: 0 12px 40px rgba(16, 24, 32, 0.08);
		backdrop-filter: blur(18px);
	}

	.brand,
	.nav-links a {
		text-decoration: none;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-family: var(--font-brand);
		font-weight: 800;
		letter-spacing: -0.04em;
	}

	.brand-mark {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 6px var(--accent-soft);
	}

	.brand-text {
		font-size: 1.05rem;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.nav-links a {
		padding: 0.55rem 0.95rem;
		border-radius: 999px;
		font-family: var(--font-brand);
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--muted);
	}

	.nav-links a:hover {
		background: var(--ink);
		color: var(--bg-soft);
	}

	@media (max-width: 560px) {
		.site-header {
			padding-inline: 10px;
		}

		.nav-shell {
			border-radius: 22px;
			flex-direction: column;
			align-items: stretch;
		}

		.nav-links {
			justify-content: space-between;
			width: 100%;
			padding-top: 2px;
		}

		.nav-links a {
			flex: 1;
			text-align: center;
			padding-inline: 0.4rem;
		}
	}
</style>
