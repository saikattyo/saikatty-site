---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPublishedBlogPosts, postSlug } from '../../lib/blog';

const posts = await getPublishedBlogPosts();

const postThemes: Record<string, string> = {
	'1': 'THOUGHT',
	'2': 'PRODUCT',
	'3': 'REVIEW',
	'4': 'MISSION',
	'5': 'MISSION',
	'6': 'PORTRAIT',
	'7': 'WORKFLOW',
	'8': 'WORKFLOW',
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Transmissions | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-hero rise">
				<p class="kicker">01 // MISSION TRANSMISSIONS</p>
				<h1>書き留めたこと</h1>
				<p>
					思考の断片、技術の試行、ミッションのメモ。公開中の全ログを新しい順に並べています。
					きれいに整える前の言葉も、あえてそのまま残しています。
				</p>
			</section>

			<section class="archive-manifest" aria-label="ブログ記事一覧">
				<div class="manifest-head" aria-hidden="true">
					<span>FLIGHT</span>
					<span>DATE</span>
					<span>CLASS</span>
					<span>TRANSMISSION</span>
					<span>OPEN</span>
				</div>
				{posts.map((post, index) => {
					const slug = postSlug(post);
					const code = `FLT-${String(posts.length - index).padStart(2, '0')}`;
					return (
						<article class="archive-row">
							<a href={`/blog/${slug}/`}>
								<span class="flight">{code}</span>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="tag">{postThemes[slug] || 'NOTE'}</span>
								<div class="summary">
									<h2>{post.data.title}</h2>
									<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
								</div>
								<span class="open">READ →</span>
							</a>
						</article>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive-hero {
		padding: clamp(2.4rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem);
		max-width: 740px;
	}

	.rise {
		animation: sx-rise 800ms var(--ease-sx) both;
	}

	.archive-hero p:last-child {
		margin-bottom: 0;
		color: var(--ink-soft);
		font-size: 1.02rem;
	}

	.archive-manifest {
		border: 1px solid var(--line);
		background: var(--bg-panel);
	}

	.manifest-head {
		display: grid;
		grid-template-columns: 90px 135px 110px minmax(0, 1fr) 90px;
		gap: 1.2rem;
		padding: 0.85rem 1.5rem;
		border-bottom: 1px solid var(--line);
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.18em;
	}

	.archive-row {
		border-bottom: 1px solid var(--line-subtle);
	}

	.archive-row:last-child {
		border-bottom: 0;
	}

	.archive-row a {
		display: grid;
		grid-template-columns: 90px 135px 110px minmax(0, 1fr) 90px;
		gap: 1.2rem;
		align-items: center;
		padding: 1.45rem 1.5rem;
		text-decoration: none;
		transition: background 180ms ease;
	}

	.archive-row a:hover {
		background: rgba(255, 255, 255, 0.05);
	}

	.archive-row a:hover h2,
	.archive-row a:hover .open {
		color: var(--accent);
	}

	.flight {
		color: #ffffff;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}

	.date {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.76rem;
	}

	.tag {
		display: inline-block;
		width: fit-content;
		padding: 0.2rem 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		color: #ffffff;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
	}

	.summary h2 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		transition: color 180ms ease;
	}

	.summary p {
		margin: 0;
		font-size: 0.9rem;
	}

	.open {
		text-align: right;
		color: #ffffff;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	@media (max-width: 960px) {
		.manifest-head {
			display: none;
		}

		.archive-row a {
			grid-template-columns: 80px 1fr auto;
			gap: 0.45rem 1rem;
		}

		.summary {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 600px) {
		.archive-row a {
			grid-template-columns: 1fr auto;
			padding: 1.15rem 1rem;
		}

		.tag {
			display: none;
		}
	}
</style>
