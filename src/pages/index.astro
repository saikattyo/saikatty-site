---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NanoStage from '../components/NanoStage.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedBlogPosts, postSlug } from '../lib/blog';

const latestPosts = (await getPublishedBlogPosts()).slice(0, 5);

const postThemes: Record<string, string> = {
	'1': 'Thought',
	'2': 'Craft',
	'3': 'Reflection',
	'4': 'Mission',
	'5': 'Mission',
	'6': 'Portrait',
	'7': 'Craft',
	'8': 'Craft',
};

const nowItems = [
	{
		label: '01 / Building',
		mode: 'nano',
		title: 'NanoFrontier',
		tag: 'DeepTech · Co-founder',
		body: '東北大学発の独自ナノ粒子化技術で、水中PFAS検出・次世代蓄電池・冷却効率などの課題に挑む。共同創業者として研究開発と事業実装をつなぐ。',
		href: PROFILE.companyUrl,
	},
	{
		label: '02 / Mission',
		mode: 'flux',
		title: '資源がなめらかに循環する社会',
		tag: 'Energy · Sustainability',
		body: '限られた人だけの高価な技術ではなく、誰もがアクセスできる低コストな仕組みとして社会に実装し、後世に続く繁栄の基盤をつくる。',
	},
	{
		label: '03 / Craft & Base',
		mode: 'matrix',
		title: `${PROFILE.location} / Software & AI`,
		tag: 'Engineering · Field Notes',
		body: '仙台の研究室と東京を行き来しながら、フルスタック開発・AIワークフロー・日々の思考実験をこの場所に掃き溜めている。',
	},
];

const pathItems = [
	{ year: '〜2019', title: '鳥取大学工学部', note: '在学中からアプリ / SaaS開発を牽引' },
	{ year: 'DeNA', title: 'Anyca', note: 'iOS / Android / サーバー / PdM' },
	{ year: 'Catalis', title: 'AI Applications', note: 'AIプロダクト開発と事業づくりを横断' },
	{ year: '2025〜', title: 'NanoFrontier', note: '共同創業・ナノ粒子技術の社会実装', current: true },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/profile_image.jpg" />
	</head>
	<body>
		<NanoStage variant="home" />
		<Header />

		<main class="home-main">
			<section class="hero" aria-label="サイト紹介と3Dモデルステージ">
				<div class="hero-copy rise">
					<p class="kicker">Co-founder @ NanoFrontier // Personal Lab</p>
					<p class="brand-signal">{PROFILE.handle}</p>
					<h1>思考を掃き溜めて、<br />次の社会実装へ。</h1>
					<p class="hero-description">
						{PROFILE.name}。東北大学発 <strong>{PROFILE.company}</strong> 共同創業者。
						ナノ粒子、エネルギー、プロダクト、日々の違和感を立体的に残していく個人アーカイブ。
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">Journalを読む →</a>
						<a class="button secondary" href="/about">いまの自分へ</a>
					</div>
				</div>

				<div class="stage-frame rise" aria-label="インタラクティブ3Dモデルコントロール">
					<div class="stage-hud-top">
						<div class="hud-left">
							<span class="hud-dot" aria-hidden="true"></span>
							<span class="hud-status" data-stage-status>LOADING GLB</span>
							<span class="hud-divider">/</span>
							<span class="hud-mode" data-stage-mode-label>01 / NANO CLUSTER</span>
						</div>
						<span class="hud-telemetry" data-stage-telemetry>AZ 340° / EL +08°</span>
					</div>

					<div
						class="stage-Interactive-window"
						data-stage-anchor
						data-stage-drag
						role="region"
						aria-label="ドラッグして3Dモデルを回転"
					>
						<span class="corner tl" aria-hidden="true"></span>
						<span class="corner tr" aria-hidden="true"></span>
						<span class="corner bl" aria-hidden="true"></span>
						<span class="corner br" aria-hidden="true"></span>
						<span class="orbit-hint">DRAG TO ORBIT 360°</span>
					</div>

					<div class="stage-hud-bottom">
						<p class="stage-caption" data-stage-caption>数十nm制御・有機ナノ粒子クラスター</p>
						<div class="stage-controls" role="toolbar" aria-label="3Dモデル表示モード切替">
							<div class="mode-pills">
								<button type="button" class="stage-btn is-active" data-stage-mode="nano" aria-pressed="true">
									01 NANO
								</button>
								<button type="button" class="stage-btn" data-stage-mode="flux" aria-pressed="false">
									02 FLUX
								</button>
								<button type="button" class="stage-btn" data-stage-mode="matrix" aria-pressed="false">
									03 MATRIX
								</button>
							</div>
							<button type="button" class="stage-btn explode-btn" data-stage-explode aria-pressed="false">
								EXPLODE / 分解
							</button>
						</div>
					</div>
				</div>
			</section>

			<section class="now-section" aria-labelledby="now-title">
				<div class="section-heading">
					<div>
						<p class="kicker">Now // Current Focus</p>
						<h2 id="now-title">いまの立ち位置</h2>
					</div>
					<p>肩書きより、いま何に手を伸ばしているかを先に置く。項目に触れると背後の3D構造も連動します。</p>
				</div>

				<div class="now-grid">
					{nowItems.map((item) => (
						<article class="now-card" data-sync-mode={item.mode}>
							<div class="now-card-top">
								<span class="now-label">{item.label}</span>
								<span class="now-tag">{item.tag}</span>
							</div>
							<h3>
								{item.href ? (
									<a href={item.href} target="_blank" rel="noopener noreferrer">
										{item.title} <span class="ext">↗</span>
									</a>
								) : (
									item.title
								)}
							</h3>
							<p>{item.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="path-section" aria-labelledby="path-title">
				<div class="section-heading compact">
					<div>
						<p class="kicker">Path // Trajectory</p>
						<h2 id="path-title">ここまでの線</h2>
					</div>
				</div>
				<ol class="path-line">
					{pathItems.map((item) => (
						<li class:list={[{ 'is-current': item.current }]}>
							<span class="path-year">{item.year}</span>
							<strong class="path-title">{item.title}</strong>
							<span class="path-note">{item.note}</span>
						</li>
					))}
				</ol>
			</section>

			<section class="latest-section" aria-labelledby="latest-title">
				<div class="section-heading">
					<div>
						<p class="kicker">Journal // Field Notes</p>
						<h2 id="latest-title">最近の投稿</h2>
					</div>
					<p>思考・クラフト・ミッション。きれいにまとめすぎず、公開中の記事を新しい順に並べています。</p>
				</div>

				<div class="post-list glass-panel">
					{latestPosts.length > 0 ? (
						latestPosts.map((post, index) => {
							const slug = postSlug(post);
							return (
								<article class="post-row">
									<a href={`/blog/${slug}`} class="post-row-link">
										<span class="post-number">{String(index + 1).padStart(2, '0')}</span>
										<div class="post-summary">
											<div class="post-meta">
												<FormattedDate date={post.data.pubDate} />
												<span class="theme-pill">{postThemes[slug] || 'Note'}</span>
											</div>
											<h3>{post.data.title}</h3>
											<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
										</div>
										<span class="read-indicator">読む →</span>
									</a>
								</article>
							);
						})
					) : (
						<div class="empty-state">
							<h3>記事を準備中です</h3>
							<p>公開まで少しだけお待ちください。</p>
						</div>
					)}
				</div>

				<div class="section-actions">
					<a class="button secondary" href="/blog">すべての投稿を見る →</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	// Sync Now cards hover/click with 3D model modes
	const syncCards = document.querySelectorAll<HTMLElement>('[data-sync-mode]');
	syncCards.forEach((card) => {
		const trigger = () => {
			const mode = card.dataset.syncMode;
			if (!mode) return;
			const btn = document.querySelector<HTMLButtonElement>(`[data-stage-mode="${mode}"]`);
			btn?.click();
		};
		card.addEventListener('mouseenter', trigger);
	});
</script>

<style>
	.home-main {
		width: min(var(--container), calc(100% - 40px));
		margin: 0 auto;
		padding: 0 0 84px;
	}

	.hero {
		min-height: calc(100svh - 86px);
		display: grid;
		grid-template-columns: minmax(0, 1.04fr) minmax(360px, 0.96fr);
		gap: clamp(1.8rem, 4vw, 3.6rem);
		align-items: center;
		padding: clamp(1.8rem, 5vw, 4rem) 0 clamp(2.5rem, 6vw, 4.5rem);
	}

	.rise {
		animation: rise-in 850ms var(--ease-out) both;
	}

	.brand-signal {
		margin: 0 0 0.9rem;
		font-family: var(--font-brand);
		font-size: clamp(2.5rem, 5.2vw, 4.4rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.98;
		white-space: nowrap;
		background: linear-gradient(125deg, #ffffff 15%, #99f6e4 58%, #38bdf8 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 12px 34px rgba(20, 184, 166, 0.22));
	}

	.hero h1 {
		margin-bottom: 1.25rem;
		font-size: clamp(2rem, 4.5vw, 3.55rem);
		line-height: 1.22;
		letter-spacing: -0.025em;
	}

	.hero-description {
		max-width: 540px;
		margin-bottom: 0;
		color: #cbd5e1;
		font-size: clamp(1rem, 1.35vw, 1.14rem);
	}

	.hero-actions,
	.section-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	/* 3D Interactive HUD Frame */
	.stage-frame {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: clamp(420px, 58svh, 560px);
		padding: 1rem;
		border: 1px solid rgba(148, 163, 184, 0.22);
		border-radius: var(--radius-lg);
		background: linear-gradient(
			160deg,
			rgba(12, 20, 32, 0.28) 0%,
			rgba(8, 13, 22, 0.06) 50%,
			rgba(12, 20, 32, 0.36) 100%
		);
		box-shadow:
			0 26px 80px rgba(0, 0, 0, 0.42),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.stage-hud-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.45rem 0.7rem;
		border: 1px solid rgba(148, 163, 184, 0.14);
		border-radius: 999px;
		background: rgba(6, 10, 17, 0.68);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		backdrop-filter: blur(12px);
	}

	.hud-left {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
	}

	.hud-dot {
		width: 7px;
		height: 7px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 10px var(--accent);
	}

	.hud-status {
		color: var(--accent);
		font-weight: 600;
	}

	.hud-divider {
		color: var(--dim);
	}

	.hud-mode {
		color: var(--ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.hud-telemetry {
		color: var(--muted);
		white-space: nowrap;
	}

	.stage-Interactive-window {
		position: relative;
		flex: 1;
		min-height: 290px;
		margin: 0.75rem 0;
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
	}

	.stage-Interactive-window.is-dragging {
		cursor: grabbing;
	}

	.corner {
		position: absolute;
		width: 14px;
		height: 14px;
		border-color: rgba(94, 234, 212, 0.55);
		border-style: solid;
		pointer-events: none;
	}

	.corner.tl {
		top: 4px;
		left: 4px;
		border-width: 1.5px 0 0 1.5px;
	}

	.corner.tr {
		top: 4px;
		right: 4px;
		border-width: 1.5px 1.5px 0 0;
	}

	.corner.bl {
		bottom: 4px;
		left: 4px;
		border-width: 0 0 1.5px 1.5px;
	}

	.corner.br {
		bottom: 4px;
		right: 4px;
		border-width: 0 1.5px 1.5px 0;
	}

	.orbit-hint {
		position: absolute;
		right: 12px;
		bottom: 10px;
		padding: 0.24rem 0.58rem;
		border: 1px solid rgba(148, 163, 184, 0.18);
		border-radius: 999px;
		background: rgba(6, 10, 17, 0.62);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.12em;
		pointer-events: none;
	}

	.stage-hud-bottom {
		display: grid;
		gap: 0.65rem;
		padding: 0.75rem 0.85rem;
		border: 1px solid rgba(148, 163, 184, 0.16);
		border-radius: 18px;
		background: rgba(6, 10, 17, 0.74);
		backdrop-filter: blur(14px);
	}

	.stage-caption {
		margin: 0;
		color: #cbd5e1;
		font-size: 0.84rem;
		line-height: 1.4;
	}

	.stage-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.mode-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.stage-btn {
		padding: 0.42rem 0.74rem;
		border: 1px solid rgba(148, 163, 184, 0.22);
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.65);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		cursor: pointer;
		transition:
			background 160ms ease,
			color 160ms ease,
			border-color 160ms ease,
			transform 160ms ease;
	}

	.stage-btn:hover {
		color: var(--ink);
		border-color: rgba(94, 234, 212, 0.45);
	}

	.stage-btn.is-active {
		border-color: var(--accent);
		background: rgba(94, 234, 212, 0.18);
		color: var(--accent);
		box-shadow: 0 0 18px rgba(94, 234, 212, 0.2);
	}

	.explode-btn.is-active {
		border-color: var(--accent-3);
		background: rgba(251, 191, 36, 0.18);
		color: var(--accent-3);
		box-shadow: 0 0 18px rgba(251, 191, 36, 0.2);
	}

	/* Content Sections */
	.now-section,
	.path-section,
	.latest-section {
		padding: clamp(4rem, 8vw, 6.8rem) 0 0;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 0.65fr);
		gap: 1.2rem 2.4rem;
		align-items: end;
		margin-bottom: 2.2rem;
	}

	.section-heading.compact {
		grid-template-columns: 1fr;
	}

	.section-heading h2 {
		margin-bottom: 0;
	}

	.section-heading > p {
		margin: 0;
	}

	.now-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.15rem;
	}

	.now-card {
		padding: 1.55rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--surface);
		box-shadow: var(--shadow-soft);
		backdrop-filter: blur(18px);
		transition:
			border-color 220ms ease,
			transform 220ms var(--ease-out),
			background 220ms ease;
	}

	.now-card:hover {
		transform: translateY(-4px);
		border-color: var(--line-bright);
		background: rgba(14, 24, 38, 0.84);
	}

	.now-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.now-label {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.now-tag {
		padding: 0.2rem 0.55rem;
		border: 1px solid rgba(148, 163, 184, 0.18);
		border-radius: 999px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.now-card h3 {
		margin-bottom: 0.75rem;
		font-size: clamp(1.3rem, 2.1vw, 1.62rem);
	}

	.now-card h3 a {
		text-decoration: none;
	}

	.ext {
		color: var(--accent);
		font-family: var(--font-brand);
		font-size: 0.95em;
	}

	.now-card p {
		margin: 0;
		font-size: 0.96rem;
		line-height: 1.78;
	}

	/* Path Trajectory */
	.path-line {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.path-line li {
		position: relative;
		padding: 1.35rem 1.25rem;
		border: 1px solid var(--line);
		border-top: 2px solid rgba(94, 234, 212, 0.45);
		border-radius: 0 0 var(--radius-md) var(--radius-md);
		background: var(--surface);
		backdrop-filter: blur(16px);
	}

	.path-line li.is-current {
		border-top-color: var(--accent);
		background: linear-gradient(180deg, rgba(20, 184, 166, 0.14) 0%, rgba(12, 19, 30, 0.8) 100%);
		box-shadow: 0 18px 44px rgba(0, 0, 0, 0.35);
	}

	.path-year {
		display: block;
		margin-bottom: 0.5rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.path-title {
		display: block;
		margin-bottom: 0.4rem;
		font-family: var(--font-display);
		font-size: 1.22rem;
		font-weight: 600;
	}

	.path-note {
		display: block;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	/* Journal Panel */
	.glass-panel {
		padding: 0.4rem 1.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-strong);
		box-shadow: var(--shadow);
		backdrop-filter: blur(20px);
	}

	.post-row {
		border-bottom: 1px solid var(--line);
	}

	.post-row:last-child {
		border-bottom: 0;
	}

	.post-row-link {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr) auto;
		gap: 1.2rem;
		align-items: center;
		padding: 1.4rem 0;
		text-decoration: none;
	}

	.post-row-link:hover h3 {
		color: var(--accent);
	}

	.post-row-link:hover .read-indicator {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateX(3px);
	}

	.post-number {
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.86rem;
		font-weight: 600;
	}

	.post-summary h3 {
		margin-bottom: 0.45rem;
	}

	.post-summary p {
		max-width: 650px;
		margin: 0;
		font-size: 0.96rem;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.theme-pill {
		padding: 0.14rem 0.55rem;
		border: 1px solid rgba(94, 234, 212, 0.28);
		border-radius: 999px;
		background: rgba(94, 234, 212, 0.08);
		color: var(--accent);
		font-size: 0.7rem;
		font-weight: 600;
	}

	.read-indicator {
		padding: 0.55rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: #cbd5e1;
