---
interface Props {
	variant?: 'home' | 'compact';
}

const { variant = 'home' } = Astro.props;
---

<div class={`sx-stage sx-stage--${variant}`} data-edition-stage data-variant={variant} aria-hidden="true">
	<canvas class="sx-canvas" data-edition-canvas></canvas>
	<div class="sx-scrim"></div>
</div>

<script>
	const stages = document.querySelectorAll<HTMLElement>('[data-edition-stage]');
	if (stages.length > 0) {
		import('../scripts/editionStage').then(({ initEditionStage }) => {
			stages.forEach((stage) => initEditionStage(stage));
		});
	}
</script>

<style>
	.sx-stage {
		pointer-events: none;
		overflow: hidden;
		background: #000000;
	}

	.sx-stage--home {
		position: fixed;
		inset: 0;
		z-index: 0;
	}

	.sx-stage--compact {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.sx-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Pure SpaceX subtle bottom-left & bottom vignette so stark white text reads with 100% clarity */
	.sx-scrim {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 22% 78%, rgba(0, 0, 0, 0.62) 0%, transparent 52%),
			linear-gradient(180deg, rgba(0, 0, 0, 0.52) 0%, transparent 16%, transparent 74%, rgba(0, 0, 0, 0.88) 100%);
	}

	@media (max-width: 860px) {
		.sx-scrim {
			background:
				linear-gradient(180deg, rgba(0, 0, 0, 0.48) 0%, transparent 22%, rgba(0, 0, 0, 0.72) 66%, rgba(0, 0, 0, 0.95) 100%);
		}
	}
</style>
