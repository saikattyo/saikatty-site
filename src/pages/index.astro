---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const latestPosts = blogPosts
	.filter((post) => post.data.published === true)
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 5);

const notes = [
	{ label: 'Thoughts', value: '日々の違和感' },
	{ label: 'Craft', value: '技術とプロダクト' },
	{ label: 'Future', value: 'エネルギーと繁栄' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-label="サイト紹介">
				<div class="hero-copy">
					<p class="kicker">Personal journal / field notes</p>
					<h1>散らかった思考に、余白と輪郭を。</h1>
					<p class="hero-description">
						Saikattyoが日常で拾った問い、技術の試行錯誤、社会や未来について考えたことを置いていく場所です。
						きれいに結論を出すより、考え続けるためのメモとして残しています。
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">最新の記事を読む</a>
						<a class="button secondary" href="/about">書いている人</a>
					</div>
				</div>
				<aside class="hero-panel" aria-label="このサイトのテーマ">
					<div class="panel-topline"></div>
					<p class="panel-label">Current themes</p>
					<div class="theme-stack">
						{notes.map((note) => (
							<div class="theme-card">
								<span>{note.label}</span>
								<strong>{note.value}</strong>
							</div>
						))}
					</div>
				</aside>
			</section>

			<section class="latest-section" aria-labelledby="latest-title">
				<div class="section-heading">
					<p class="kicker">Latest entries</p>
					<h2 id="latest-title">最近の投稿</h2>
					<p>公開中の記事から新しいものをピックアップ。気になったタイトルからどうぞ。</p>
				</div>

				<div class="post-list">
					{latestPosts.length > 0 ? (
						latestPosts.map((post, index) => (
							<article class="post-row">
								<a href={`/blog/${post.id}`} class="post-row-link">
									<span class="post-number">{String(index + 1).padStart(2, '0')}</span>
									<div class="post-thumb">
										<img src={post.data.heroImage || '/blog-placeholder-1.jpg'} alt="" loading="lazy" />
									</div>
									<div class="post-summary">
										<div class="post-meta">
											<FormattedDate date={post.data.pubDate} />
											<span>Essay</span>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
									</div>
									<span class="read-indicator">読む</span>
								</a>
							</article>
						))
					) : (
						<div class="empty-state">
							<h3>記事を準備中です</h3>
							<p>公開まで少しだけお待ちください。</p>
						</div>
					)}
				</div>

				<div class="section-actions">
					<a class="button secondary" href="/blog">すべての投稿を見る</a>
				</div>
			</section>

			<section class="about-strip" aria-label="サイトの方向性">
				<div>
					<p class="kicker">What this place is for</p>
					<h2>未完成な考えを、そのまま進めるために。</h2>
				</div>
				<p>
					日々の記録、技術の探索、エネルギーや人類の繁栄についてのメモを横断して残します。
					読みやすさと余白を大切に、古いノートをめくるようなサイトにしました。
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		min-height: calc(100vh - 142px);
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding: 48px 0 80px;
	}

	.kicker {
		margin-bottom: 1rem;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 840px;
	}

	.hero-description {
		max-width: 700px;
		font-size: clamp(1.05rem, 1.5vw, 1.3rem);
	}

	.hero-actions,
	.section-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		padding: 0.85rem 1.25rem;
		border: 1px solid var(--ink);
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
	}

	.button.primary {
		background: var(--ink);
		color: var(--bg-soft);
		box-shadow: 0 14px 30px rgba(23, 19, 13, 0.18);
	}

	.button.secondary {
		background: rgba(255, 250, 241, 0.45);
		color: var(--ink);
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.hero-panel {
		position: relative;
		padding: 28px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(160deg, rgba(255, 250, 241, 0.86), rgba(255, 250, 241, 0.54)),
			url('/profile_image.jpg') center / cover;
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.hero-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(246, 240, 230, 0.24), rgba(246, 240, 230, 0.92));
	}

	.hero-panel > * {
		position: relative;
	}

	.panel-topline {
		width: 100%;
		height: 280px;
		border: 1px solid rgba(23, 19, 13, 0.16);
		border-radius: 24px;
		background: rgba(255, 250, 241, 0.24);
		backdrop-filter: blur(2px);
	}

	.panel-label {
		margin: 1.5rem 0 0.8rem;
		color: var(--ink);
		font-weight: 700;
	}

	.theme-stack {
		display: grid;
		gap: 0.7rem;
	}

	.theme-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(255, 250, 241, 0.76);
		backdrop-filter: blur(10px);
	}

	.theme-card span {
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.latest-section,
	.about-strip {
		padding: clamp(3rem, 8vw, 7rem) 0;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.55fr);
		gap: 2rem;
		align-items: end;
		margin-bottom: 2rem;
	}

	.section-heading p:last-child {
		margin-bottom: 0;
	}

	.post-list {
		border-top: 1px solid var(--line);
	}

	.post-row {
		border-bottom: 1px solid var(--line);
	}

	.post-row-link {
		display: grid;
		grid-template-columns: 54px 180px minmax(0, 1fr) auto;
		gap: 1.4rem;
		align-items: center;
		padding: 1.25rem 0;
		text-decoration: none;
	}

	.post-number {
		color: rgba(23, 19, 13, 0.34);
		font-weight: 700;
	}

	.post-thumb {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 20px;
		background: var(--bg-soft);
	}

	.post-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.post-row-link:hover .post-thumb img {
		transform: scale(1.05);
	}

	.post-summary h3 {
		margin-bottom: 0.6rem;
	}

	.post-summary p {
		max-width: 620px;
		margin: 0;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 0.6rem;
		color: var(--accent-2);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.read-indicator {
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.empty-state {
		padding: 2rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--card);
	}

	.about-strip {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(280px, 0.7fr);
		gap: 2rem;
		align-items: start;
		margin-top: 3rem;
		padding: clamp(2rem, 5vw, 4rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: rgba(255, 250, 241, 0.58);
		box-shadow: var(--shadow-soft);
	}

	.about-strip p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 860px) {
		.hero,
		.section-heading,
		.about-strip {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
			padding-top: 32px;
		}

		.post-row-link {
			grid-template-columns: 42px minmax(0, 1fr);
		}

		.post-thumb,
		.read-indicator {
			display: none;
		}
	}

	@media (max-width: 520px) {
		.hero-actions,
		.section-actions {
			flex-direction: column;
		}

		.button {
			width: 100%;
		}
	}
</style>
