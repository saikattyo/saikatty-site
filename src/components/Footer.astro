---
import { PROFILE, SITE_TITLE } from '../consts';

const today = new Date();
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Journal' },
	{ href: '/about', label: 'About' },
];
const socials = [
	{ href: PROFILE.x, label: 'X' },
	{ href: PROFILE.github, label: 'GitHub' },
	{ href: PROFILE.linkedin, label: 'LinkedIn' },
	{ href: PROFILE.companyUrl, label: 'NanoFrontier' },
];
---

<footer class="site-footer">
	<div class="footer-shell">
		<div class="footer-copy">
			<p class="eyebrow">{SITE_TITLE}</p>
			<h2>思考を掃き溜めて、次の一手に変える。</h2>
			<p>
				{PROFILE.name} / {PROFILE.handle}。{PROFILE.company}の共同創業者として、ナノ粒子と社会実装のあいだを行き来しながら書いています。
			</p>
		</div>
		<div class="footer-links" aria-label="フッターナビゲーション">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
		<div class="social-links">
			{socials.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer">
					{link.label}
				</a>
			))}
		</div>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} {PROFILE.name}</span>
		<span>{PROFILE.location}</span>
	</div>
</footer>

<style>
	.site-footer {
		width: min(var(--container), calc(100% - 40px));
		margin: 0 auto 28px;
		padding: 36px;
		border: 1px solid rgba(247, 249, 251, 0.12);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(circle at 18% 0%, rgba(13, 115, 119, 0.35), transparent 40%),
			linear-gradient(145deg, #101820 0%, #15202b 55%, #0d3a3c 100%);
		color: var(--bg-soft);
		box-shadow: var(--shadow);
	}

	.footer-shell {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) auto auto;
		gap: 2rem;
		align-items: end;
	}

	.eyebrow {
		margin-bottom: 0.85rem;
		color: rgba(247, 249, 251, 0.55);
		font-family: var(--font-brand);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.footer-copy h2 {
		max-width: 680px;
		margin-bottom: 1rem;
		color: var(--bg-soft);
		font-size: clamp(1.9rem, 4vw, 3.4rem);
	}

	.footer-copy p:last-child {
		max-width: 620px;
		margin: 0;
		color: rgba(247, 249, 251, 0.68);
	}

	.footer-links,
	.social-links {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.footer-links a,
	.social-links a {
		color: rgba(247, 249, 251, 0.72);
		font-family: var(--font-brand);
		font-weight: 700;
		text-decoration: none;
	}

	.footer-links a:hover,
	.social-links a:hover {
		color: #7fd4d6;
	}

	.footer-bottom {
		margin-top: 2.4rem;
		padding-top: 1rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid rgba(247, 249, 251, 0.12);
		color: rgba(247, 249, 251, 0.5);
		font-size: 0.88rem;
	}

	@media (max-width: 780px) {
		.site-footer {
			width: min(100% - 28px, var(--container));
			padding: 24px;
		}

		.footer-shell {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.footer-links,
		.social-links {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.85rem 1.2rem;
		}

		.footer-bottom {
			flex-direction: column;
		}
	}
</style>
