---
const pathname = Astro.url.pathname;
const navItems = [
	{ href: '/', code: '00', label: 'FLIGHT DECK', active: pathname === '/' },
	{ href: '/blog', code: '01', label: 'TRANSMISSIONS', active: pathname.startsWith('/blog') },
	{ href: '/about', code: '02', label: 'DOSSIER', active: pathname.startsWith('/about') },
];
---

<header class="site-header">
	<nav class="nav-bar" aria-label="メインナビゲーション">
		<a class="brand" href="/" aria-label="Saikattyo ホーム">
			<svg class="brand-glyph" viewBox="0 0 36 22" fill="none" aria-hidden="true">
				<path d="M2 20 C11 9, 22 4, 35 2 C24 7, 14 13, 8 20 Z" fill="currentColor" />
			</svg>
			<span class="brand-word">SAIKATTYO</span>
		</a>

		<div class="nav-links">
			{navItems.map((item) => (
				<a
					href={item.href}
					class:list={[{ 'is-current': item.active }]}
					aria-current={item.active ? 'page' : undefined}
				>
					<span class="nav-code">{item.code}</span>
					<span>{item.label}</span>
				</a>
			))}
		</div>

		<div class="nav-status" aria-hidden="true">
			<span class="signal-dot"></span>
			<span>ORBITAL LINK // TOKYO-SENDAI</span>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(2, 4, 8, 0.72);
		backdrop-filter: blur(16px);
	}

	.nav-bar {
		width: min(var(--container), calc(100% - 48px));
		height: 70px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: #ffffff;
		text-decoration: none;
	}

	.brand-glyph {
		width: 28px;
		height: 18px;
		color: #ffffff;
	}

	.brand-word {
		font-family: var(--font-brand);
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: 0.28em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.8rem;
	}

	.nav-links a {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.4rem 0;
		color: rgba(255, 255, 255, 0.68);
		font-family: var(--font-display);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-decoration: none;
	}

	.nav-links a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: #ffffff;
		transform: scaleX(0);
		transform-origin: right center;
		transition: transform 300ms var(--ease-sx);
	}

	.nav-links a:hover,
	.nav-links a.is-current {
		color: #ffffff;
	}

	.nav-links a:hover::after,
	.nav-links a.is-current::after {
		transform: scaleX(1);
		transform-origin: left center;
	}

	.nav-code {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
	}

	.nav-status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.14em;
	}

	.signal-dot {
		width: 6px;
		height: 6px;
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	@media (max-width: 980px) {
		.nav-status {
			display: none;
		}
	}

	@media (max-width: 680px) {
		.nav-bar {
			width: calc(100% - 28px);
			height: 60px;
			gap: 0.6rem;
		}

		.brand-glyph {
			width: 22px;
			height: 14px;
		}

		.brand-word {
			font-size: 0.86rem;
			letter-spacing: 0.18em;
		}

		.nav-links {
			gap: 0.85rem;
		}

		.nav-code {
			display: none;
		}

		.nav-links a {
			font-size: 0.76rem;
			letter-spacing: 0.12em;
		}
	}
</style>
