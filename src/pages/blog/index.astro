---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPublishedBlogPosts, postSlug } from '../../lib/blog';

const posts = await getPublishedBlogPosts();
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Journal | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="sx-archive-hero rise">
				<p class="sx-overline">PERSONAL ARCHIVE</p>
				<h1>JOURNAL</h1>
				<p>
					思考の断片、技術の試行、ミッションのメモ。公開中の投稿を新しい順に並べています。
					きれいに整える前の言葉も、あえて残しています。
				</p>
			</section>

			<section class="sx-archive-list" aria-label="ブログ記事一覧">
				{posts.map((post) => {
					const slug = postSlug(post);
					return (
						<article class="sx-archive-row">
							<a href={`/blog/${slug}/`}>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								<div class="summary">
									<h2>{post.data.title}</h2>
									<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
								</div>
								<span class="cta">READ</span>
							</a>
						</article>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.sx-archive-hero {
		padding: clamp(2rem, 5vw, 3.6rem) 0 clamp(2.2rem, 4vw, 3.2rem);
		max-width: 680px;
	}

	.rise {
		animation: sx-fade-up 800ms var(--ease-sx) both;
	}

	.sx-archive-hero h1 {
		margin-bottom: 1rem;
		font-family: var(--font-sx);
		font-size: clamp(2.8rem, 6vw, 4.6rem);
		letter-spacing: 0.05em;
	}

	.sx-archive-hero p:last-child {
		margin: 0;
		color: var(--muted);
		font-size: 0.98rem;
	}

	.sx-archive-list {
		border-top: 1px solid var(--line);
	}

	.sx-archive-row {
		border-bottom: 1px solid var(--line-subtle);
	}

	.sx-archive-row a {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1.75rem 0;
		text-decoration: none;
	}

	.date {
		color: var(--muted);
		font-family: var(--font-sx);
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.summary h2 {
		margin: 0 0 0.35rem;
		font-family: var(--font-body);
		font-size: clamp(1.15rem, 2.1vw, 1.38rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.summary p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.cta {
		padding: 0.55rem 1.2rem;
		border: 1px solid rgba(255, 255, 255, 0.38);
		color: #ffffff;
		font-family: var(--font-sx);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		transition:
			background 220ms var(--ease-sx),
			color 220ms var(--ease-sx),
			border-color 220ms var(--ease-sx);
	}

	.sx-archive-row a:hover .cta {
		background: #ffffff;
		border-color: #ffffff;
		color: #000000;
	}

	@media (max-width: 760px) {
		.sx-archive-row a {
			grid-template-columns: 1fr;
			gap: 0.45rem;
		}

		.cta {
			display: none;
		}
	}
</style>
