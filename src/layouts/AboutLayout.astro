---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="about-main">
			<article>
				<header class="about-hero">
					{heroImage && (
						<div class="hero-plane" aria-hidden="true">
							<img src={heroImage} alt="" />
							<div class="hero-veil"></div>
						</div>
					)}
					<div class="about-copy rise">
						<p class="kicker">About</p>
						<p class="brand-signal">Saikattyo</p>
						<h1>{title}</h1>
						<p class="lede">{description}</p>
					</div>
				</header>
				<div class="prose about-content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-main {
		width: 100%;
		max-width: none;
		padding: 0 0 64px;
	}

	.about-hero {
		position: relative;
		isolation: isolate;
		min-height: min(72svh, 720px);
		display: grid;
		align-items: end;
		padding: clamp(4rem, 10vw, 7rem) max(20px, calc((100% - 1040px) / 2)) 3rem;
		overflow: hidden;
		color: var(--bg-soft);
	}

	.hero-plane {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.hero-plane img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
		border-radius: 0;
		animation: soft-zoom 16s var(--ease-out) both;
	}

	.hero-veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(115deg, rgba(16, 24, 32, 0.9) 10%, rgba(16, 24, 32, 0.5) 55%, rgba(13, 58, 60, 0.28) 100%),
			linear-gradient(to top, rgba(16, 24, 32, 0.75), transparent 48%);
	}

	.rise {
		animation: rise-in 900ms var(--ease-out) both;
	}

	.brand-signal {
		margin: 0 0 0.8rem;
		font-family: var(--font-brand);
		font-size: clamp(2rem, 6vw, 3.8rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 0.95;
		color: #7fd4d6;
	}

	.about-copy h1 {
		color: var(--bg-soft);
		font-size: clamp(2rem, 5vw, 3.4rem);
	}

	.lede {
		max-width: 640px;
		margin: 0;
		color: rgba(247, 249, 251, 0.78);
		font-size: 1.12rem;
	}

	.about-content {
		width: min(760px, calc(100% - 40px));
		margin: -2rem auto 0;
		padding: clamp(1.6rem, 4vw, 2.8rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: rgba(247, 249, 251, 0.88);
		box-shadow: var(--shadow);
		backdrop-filter: blur(10px);
		position: relative;
		z-index: 1;
	}

	@media (max-width: 720px) {
		.about-content {
			width: min(100% - 28px, 760px);
			margin-top: -1.2rem;
		}
	}
</style>
