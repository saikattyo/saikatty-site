---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NanoStage from '../components/NanoStage.astro';

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image="/profile_image_about.jpg" />
	</head>
	<body>
		<Header />
		<main class="sx-about-main">
			<article>
				<header class="sx-about-hero">
					<NanoStage variant="compact" />
					<div class="sx-about-hero-inner rise">
						<p class="sx-overline">PROFILE // KATSUYA SAITO</p>
						<h1>ABOUT</h1>
						<p class="sx-about-lede">{description}</p>
					</div>
				</header>

				<div class="prose sx-about-body">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.sx-about-main {
		width: 100%;
		max-width: none;
		padding: 0 0 100px !important;
	}

	.sx-about-hero {
		position: relative;
		isolation: isolate;
		min-height: 68svh;
		display: flex;
		align-items: flex-end;
		padding: 130px max(32px, calc((100% - var(--container)) / 2)) 4rem;
		border-bottom: 1px solid var(--line-subtle);
		overflow: hidden;
	}

	.sx-about-hero-inner {
		position: relative;
		z-index: 2;
		max-width: 580px;
	}

	.rise {
		animation: sx-fade-up 850ms var(--ease-sx) both;
	}

	.sx-about-hero h1 {
		margin: 0 0 0.9rem;
		font-family: var(--font-sx);
		font-size: clamp(3rem, 6vw, 4.8rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.sx-about-lede {
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: 1rem;
	}

	.sx-about-body {
		width: min(820px, calc(100% - 64px));
		margin: 4rem auto 0;
	}

	@media (max-width: 760px) {
		.sx-about-hero {
			padding: 250px 20px 3rem;
		}

		.sx-about-body {
			width: calc(100% - 40px);
			margin-top: 2.8rem;
		}
	}
</style>
