---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.published === true)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Journal | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-hero">
				<p class="kicker">Archive</p>
				<h1>書き留めたこと</h1>
				<p>公開中の投稿を新しい順に並べています。思考の断片、技術のメモ、ふとした気づきの保管庫です。</p>
			</section>

			<section class="archive-grid" aria-label="ブログ記事一覧">
				{posts.map((post) => (
					<article class="archive-card">
						<a href={`/blog/${post.id}/`}>
							<div class="card-image">
								<img width="720" height="420" src={post.data.heroImage || '/blog-placeholder-1.jpg'} alt="" loading="lazy" />
							</div>
							<div class="card-body">
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<h2>{post.data.title}</h2>
								<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
							</div>
						</a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive-hero {
		padding: clamp(3rem, 8vw, 7rem) 0 clamp(2rem, 5vw, 4rem);
		max-width: 820px;
	}

	.kicker {
		margin-bottom: 1rem;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.archive-hero p:last-child {
		font-size: 1.18rem;
	}

	.archive-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.archive-card a {
		display: flex;
		height: 100%;
		min-height: 460px;
		flex-direction: column;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: rgba(255, 250, 241, 0.62);
		box-shadow: var(--shadow-soft);
		overflow: hidden;
		text-decoration: none;
	}

	.archive-card:first-child {
		grid-column: span 2;
	}

	.archive-card:first-child a {
		min-height: 520px;
	}

	.card-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg-soft);
	}

	.archive-card:first-child .card-image {
		aspect-ratio: 16 / 8;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 300ms ease;
	}

	.archive-card a:hover .card-image img {
		transform: scale(1.04);
	}

	.card-body {
		padding: 1.35rem;
	}

	.date {
		margin-bottom: 0.8rem;
		color: var(--accent-2);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.card-body h2 {
		font-size: clamp(1.45rem, 2.6vw, 2.35rem);
		margin-bottom: 0.8rem;
	}

	.card-body p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 920px) {
		.archive-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.archive-grid {
			grid-template-columns: 1fr;
		}

		.archive-card:first-child {
			grid-column: auto;
		}

		.archive-card a,
		.archive-card:first-child a {
			min-height: auto;
		}
	}
</style>
