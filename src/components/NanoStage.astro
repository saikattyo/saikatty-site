---
interface Props {
	variant?: 'home' | 'compact';
}

const { variant = 'home' } = Astro.props;
---

<div class={`nano-stage nano-stage--${variant}`} data-nano-stage data-variant={variant} aria-hidden="true">
	<canvas class="nano-canvas" data-nano-canvas></canvas>
	<div class="nano-vignette"></div>
	<div class="nano-fallback-orb"></div>
</div>

<script>
	const stages = document.querySelectorAll<HTMLElement>('[data-nano-stage]');
	if (stages.length > 0) {
		import('../scripts/nanoStage').then(({ initNanoStage }) => {
			stages.forEach((stage) => initNanoStage(stage));
		});
	}
</script>

<style>
	.nano-stage {
		pointer-events: none;
		overflow: hidden;
	}

	.nano-stage--home {
		position: fixed;
		inset: 0;
		z-index: 0;
	}

	.nano-stage--compact {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.nano-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.nano-vignette {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 72% 44%, transparent 26%, rgba(6, 9, 14, 0.44) 72%, rgba(6, 9, 14, 0.86) 100%),
			linear-gradient(90deg, rgba(6, 9, 14, 0.62) 0%, rgba(6, 9, 14, 0.18) 50%, rgba(6, 9, 14, 0.08) 100%);
	}

	.nano-fallback-orb {
		display: none;
	}

	.nano-stage.webgl-fallback .nano-fallback-orb {
		display: block;
		position: absolute;
		top: 18%;
		right: 12%;
		width: min(420px, 68vw);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid rgba(94, 234, 212, 0.35);
		background:
			radial-gradient(circle at 36% 32%, rgba(94, 234, 212, 0.42), rgba(13, 148, 136, 0.14) 48%, transparent 72%);
		box-shadow: 0 0 120px rgba(45, 212, 191, 0.22);
	}

	@media (max-width: 860px) {
		.nano-vignette {
			background:
				radial-gradient(circle at 50% 28%, transparent 12%, rgba(6, 9, 14, 0.62) 62%, rgba(6, 9, 14, 0.92) 100%),
				linear-gradient(180deg, rgba(6, 9, 14, 0.18) 0%, rgba(6, 9, 14, 0.68) 54%, rgba(6, 9, 14, 0.94) 100%);
		}
	}
</style>
