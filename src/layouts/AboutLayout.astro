---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NanoStage from '../components/NanoStage.astro';

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="about-main">
			<article>
				<header class="about-hero">
					<NanoStage variant="compact" />
					<div class="about-hero-inner rise">
						<div class="about-copy">
							<p class="kicker">About // Profile</p>
							<div class="identity-row">
								{heroImage && (
									<img class="avatar" src={heroImage} alt="斎藤 克哉 プロフィール" width="76" height="76" />
								)}
								<p class="brand-signal">Saikattyo</p>
							</div>
							<h1>{title}</h1>
							<p class="lede">{description}</p>
						</div>
						<div class="about-stage-anchor" data-stage-anchor data-stage-drag aria-hidden="true"></div>
					</div>
				</header>
				<div class="prose about-content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-main {
		width: 100%;
		max-width: none;
		padding: 0 0 72px;
	}

	.about-hero {
		position: relative;
		isolation: isolate;
		min-height: min(64svh, 580px);
		display: grid;
		align-items: center;
		padding: clamp(2.5rem, 7vw, 5rem) max(20px, calc((100% - var(--container)) / 2));
		overflow: hidden;
	}

	.about-hero-inner {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: 2rem;
		align-items: center;
	}

	.rise {
		animation: rise-in 850ms var(--ease-out) both;
	}

	.identity-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}

	.avatar {
		width: 68px;
		height: 68px;
		object-fit: cover;
		border-radius: 20px;
		border: 1px solid var(--line-bright);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
	}

	.brand-signal {
		margin: 0;
		font-family: var(--font-brand);
		font-size: clamp(2rem, 5.5vw, 3.6rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 0.95;
		background: linear-gradient(125deg, #ffffff 15%, #99f6e4 65%, #38bdf8 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.about-copy h1 {
		font-size: clamp(1.95rem, 4.6vw, 3.2rem);
	}

	.lede {
		max-width: 620px;
		margin: 0;
		color: #cbd5e1;
		font-size: 1.08rem;
	}

	.about-stage-anchor {
		min-height: 300px;
		cursor: grab;
		touch-action: pan-y;
	}

	.about-content {
		width: min(820px, calc(100% - 40px));
		margin: -1.2rem auto 0;
		padding: clamp(1.7rem, 4vw, 3rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-strong);
		box-shadow: var(--shadow);
		backdrop-filter: blur(20px);
		position: relative;
		z-index: 3;
	}

	@media (max-width: 860px) {
		.about-hero-inner {
			grid-template-columns: 1fr;
		}

		.about-stage-anchor {
			order: -1;
			min-height: 210px;
		}

		.about-content {
			width: min(100% - 28px, 820px);
			margin-top: 0;
		}
	}
</style>
