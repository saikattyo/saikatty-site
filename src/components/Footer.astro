---
import { PROFILE, SITE_TITLE } from '../consts';

const today = new Date();
const links = [
	{ href: '/', label: '00 FLIGHT DECK' },
	{ href: '/blog', label: '01 TRANSMISSIONS' },
	{ href: '/about', label: '02 DOSSIER' },
];
const socials = [
	{ href: PROFILE.x, label: 'X / TWITTER' },
	{ href: PROFILE.github, label: 'GITHUB' },
	{ href: PROFILE.linkedin, label: 'LINKEDIN' },
	{ href: PROFILE.companyUrl, label: 'NANOFRONTIER INC.' },
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-copy">
				<p class="eyebrow">{SITE_TITLE} // MISSION ARCHIVE</p>
				<h2>思考を掃き溜めて、次の一手に変える。</h2>
				<p>
					{PROFILE.name}（{PROFILE.handle}）— {PROFILE.company} 共同創業者。
					ナノ粒子技術と社会実装のあいだを往復しながら記録を残しています。
				</p>
			</div>

			<div class="footer-col" aria-label="フッターナビゲーション">
				<span class="col-head">NAVIGATION</span>
				{links.map((link) => <a href={link.href}>{link.label}</a>)}
			</div>

			<div class="footer-col">
				<span class="col-head">EXTERNAL LINKS</span>
				{socials.map((link) => (
					<a href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label} ↗
					</a>
				))}
			</div>
		</div>

		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} KATSUYA SAITO // SAIKATTYO</span>
			<span>35.6762°N 139.6503°E TOKYO — 38.2682°N 140.8694°E SENDAI</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 2;
		border-top: 1px solid var(--line);
		background: rgba(2, 4, 8, 0.92);
		backdrop-filter: blur(18px);
	}

	.footer-inner {
		width: min(var(--container), calc(100% - 48px));
		margin: 0 auto;
		padding: 56px 0 36px;
	}

	.footer-top {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) auto auto;
		gap: 3rem;
		align-items: start;
	}

	.eyebrow {
		margin-bottom: 0.85rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.footer-copy h2 {
		max-width: 640px;
		margin-bottom: 0.9rem;
		font-size: clamp(1.6rem, 3.2vw, 2.5rem);
	}

	.footer-copy p:last-child {
		max-width: 560px;
		margin: 0;
		font-size: 0.95rem;
	}

	.col-head {
		margin-bottom: 0.45rem;
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-col a {
		color: rgba(255, 255, 255, 0.78);
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-decoration: none;
	}

	.footer-col a:hover {
		color: #ffffff;
	}

	.footer-bottom {
		margin-top: 3rem;
		padding-top: 1.25rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid var(--line-subtle);
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 780px) {
		.footer-inner {
			width: calc(100% - 28px);
			padding: 40px 0 28px;
		}

		.footer-top {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
