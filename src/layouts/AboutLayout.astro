---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NanoStage from '../components/NanoStage.astro';

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="dossier-main">
			<article>
				<header class="dossier-hero" data-orbital-drag>
					<NanoStage variant="compact" />
					<div class="dossier-hero-inner rise">
						<div class="dossier-copy">
							<p class="kicker">02 // MISSION DOSSIER</p>
							<div class="identity-bar">
								{heroImage && (
									<img class="dossier-avatar" src={heroImage} alt="斎藤 克哉" width="68" height="68" />
								)}
								<div>
									<p class="callsign">SAIKATTYO</p>
									<span class="sub-id">CO-FOUNDER // NANOFRONTIER INC.</span>
								</div>
							</div>
							<h1>{title}</h1>
							<p class="lede">{description}</p>
						</div>
					</div>
				</header>

				<div class="prose dossier-body">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.dossier-main {
		width: 100%;
		max-width: none;
		padding: 0 0 88px;
	}

	.dossier-hero {
		position: relative;
		isolation: isolate;
		min-height: min(64svh, 560px);
		display: flex;
		align-items: flex-end;
		padding: clamp(3rem, 8vw, 5.5rem) max(24px, calc((100% - var(--container)) / 2)) 3.2rem;
		border-bottom: 1px solid var(--line);
		overflow: hidden;
		cursor: grab;
	}

	.dossier-hero.is-dragging {
		cursor: grabbing;
	}

	.dossier-hero-inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 640px;
	}

	.rise {
		animation: sx-rise 850ms var(--ease-sx) both;
	}

	.identity-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.dossier-avatar {
		width: 64px;
		height: 64px;
		object-fit: cover;
		border: 1px solid rgba(255, 255, 255, 0.55);
	}

	.callsign {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 4.5vw, 3.2rem);
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1;
		color: #ffffff;
	}

	.sub-id {
		display: block;
		margin-top: 0.25rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
	}

	.dossier-copy h1 {
		font-size: clamp(1.85rem, 4vw, 2.85rem);
		margin-bottom: 0.85rem;
	}

	.lede {
		margin: 0;
		color: var(--ink-soft);
		font-size: 1.02rem;
	}

	.dossier-body {
		width: min(860px, calc(100% - 48px));
		margin: 3rem auto 0;
		padding: clamp(1.8rem, 4vw, 3.2rem);
		border: 1px solid var(--line);
		background: var(--bg-panel);
	}

	@media (max-width: 720px) {
		.dossier-hero {
			padding-top: 210px;
		}

		.dossier-body {
			width: calc(100% - 28px);
			margin-top: 1.8rem;
		}
	}
</style>
