---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPublishedBlogPosts, postSlug } from '../../lib/blog';

const posts = await getPublishedBlogPosts();

const postThemes: Record<string, string> = {
	'1': 'Thought',
	'2': 'Craft',
	'3': 'Reflection',
	'4': 'Mission',
	'5': 'Mission',
	'6': 'Portrait',
	'7': 'Craft',
	'8': 'Craft',
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Journal | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-hero">
				<p class="kicker">Journal</p>
				<h1>書き留めたこと</h1>
				<p>
					思考の断片、技術の試行、ミッションのメモ。公開中の投稿を新しい順に並べています。
					きれいに整える前の言葉も、あえて残しています。
				</p>
			</section>

			<section class="archive-list" aria-label="ブログ記事一覧">
				{posts.map((post, index) => {
					const slug = postSlug(post);
					return (
					<article class="archive-row">
						<a href={`/blog/${slug}/`}>
							<span class="index">{String(index + 1).padStart(2, '0')}</span>
							<div class="meta">
								<FormattedDate date={post.data.pubDate} />
								<span>{postThemes[slug] || 'Note'}</span>
							</div>
							<h2>{post.data.title}</h2>
							<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
						</a>
					</article>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive-hero {
		padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
		max-width: 760px;
	}

	.archive-hero p:last-child {
		font-size: 1.12rem;
		margin-bottom: 0;
	}

	.archive-list {
		border-top: 1px solid var(--line);
	}

	.archive-row {
		border-bottom: 1px solid var(--line);
	}

	.archive-row a {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr);
		gap: 0.35rem 1.2rem;
		padding: 1.5rem 0;
		text-decoration: none;
	}

	.archive-row a:hover h2 {
		color: var(--accent);
	}

	.index {
		grid-row: span 3;
		padding-top: 0.35rem;
		color: rgba(16, 24, 32, 0.28);
		font-family: var(--font-brand);
		font-weight: 700;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		color: var(--accent);
		font-family: var(--font-brand);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.archive-row h2 {
		margin: 0;
		font-size: clamp(1.35rem, 2.8vw, 2rem);
	}

	.archive-row p {
		margin: 0;
		max-width: 640px;
	}

	@media (max-width: 560px) {
		.archive-row a {
			grid-template-columns: 1fr;
		}

		.index {
			grid-row: auto;
		}
	}
</style>
