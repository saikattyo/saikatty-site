---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width,initial-scale=1,maximum-scale=1"
		/>
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#000000" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black" />
		<meta name="apple-mobile-web-app-title" content="Studio" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/studio.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700;900&family=Space+Grotesk:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>STUDIO | {SITE_TITLE}</title>
	</head>
	<body class="studio-body">
		<div class="studio-shell" data-studio-shell>
			<!-- BACKDROPS FOR MOBILE DRAWER & SHEET -->
			<div class="sheet-backdrop" data-sidebar-backdrop hidden></div>
			<div class="sheet-backdrop" data-props-backdrop hidden></div>

			<!-- LEFT VAULT SIDEBAR (SLIDE-OVER ON MOBILE) -->
			<aside class="vault-sidebar" data-studio-sidebar aria-label="日誌・ノート一覧">
				<div class="vault-head">
					<a href="/" class="vault-brand" title="公開サイトへ戻る">
						<span class="vault-brand-word">SAIKATTYO</span>
						<span class="vault-badge">STUDIO</span>
					</a>
					<button
						type="button"
						class="sheet-close-btn mobile-only"
						data-btn-close-sidebar
						aria-label="サイドバーを閉じる"
					>
						閉じる
					</button>
				</div>

				<div class="vault-primary-actions">
					<button type="button" class="vault-action-primary" data-btn-daily>
						＋ 今日の日誌を書く
					</button>
					<div class="vault-action-row">
						<button type="button" class="vault-action-sub" data-btn-new>
							＋ 新規ノート
						</button>
						<button type="button" class="vault-action-sub" data-btn-import-md>
							↑ .md 取込
						</button>
						<input
							type="file"
							accept=".md,.mdx,text/markdown,text/plain"
							data-input-import-md
							hidden
						/>
					</div>
				</div>

				<div class="vault-search-box">
					<input
						type="search"
						placeholder="タイトル・タグ・日付で検索…"
						data-input-search
						aria-label="ノート検索"
					/>
					<div class="vault-filters" role="tablist" aria-label="公開状態フィルタ">
						<button type="button" class="filter-pill is-active" data-filter="all">
							すべて
						</button>
						<button type="button" class="filter-pill" data-filter="published">
							公開中
						</button>
						<button type="button" class="filter-pill" data-filter="draft">
							下書き
						</button>
					</div>
				</div>

				<div class="vault-count-row">
					<span data-entry-count>0 NOTES</span>
					<span class="conn-label" data-conn-badge>CONNECTING</span>
				</div>

				<div class="vault-list" data-entry-list role="list"></div>

				<div class="vault-foot">
					<a href="/blog" class="vault-foot-link">公開JOURNALを見る ↗</a>
					<button type="button" class="vault-foot-btn" data-btn-logout hidden>
						ログアウト
					</button>
				</div>
			</aside>

			<!-- MAIN EDITOR WORKSPACE -->
			<section class="editor-workspace" aria-label="Markdownエディタ">
				<!-- SAFE-AREA AWARE TOP BAR -->
				<header class="workspace-topbar">
					<div class="topbar-left">
						<!-- Mobile: clean tappable note status chip (opens Settings sheet) -->
						<button
							type="button"
							class="mobile-meta-chip mobile-only"
							data-btn-mobile-meta
							title="公開設定・プロパティを開く"
						>
							<span class="chip-dot" data-mobile-pub-dot></span>
							<span class="chip-date" data-mobile-date-label>----.--.--</span>
							<span class="chip-sync" data-mobile-sync-label>同期済</span>
						</button>

						<!-- Desktop controls -->
						<label class="pub-switch desktop-only" title="公開 / 下書き切替">
							<input type="checkbox" checked data-input-published />
							<span class="pub-indicator"></span>
							<span class="pub-text" data-published-label>公開 (Published)</span>
						</label>

						<button
							type="button"
							class="top-pill desktop-only"
							data-btn-toggle-props
							title="スラッグ・日付・タグ・アイキャッチ設定"
						>
							プロパティ
						</button>
					</div>

					<div class="topbar-center desktop-only">
						<div class="view-switcher" role="toolbar" aria-label="表示モード切替">
							<button type="button" class="view-btn" data-view-mode="edit" aria-pressed="true">
								EDIT
							</button>
							<button type="button" class="view-btn" data-view-mode="split" aria-pressed="false">
								SPLIT
							</button>
							<button type="button" class="view-btn" data-view-mode="preview" aria-pressed="false">
								PREVIEW
							</button>
						</div>
					</div>

					<div class="topbar-right">
						<a
							href="/blog"
							target="_blank"
							rel="noopener noreferrer"
							class="top-pill desktop-only"
							data-link-open-live
							hidden
						>
							公開ページ ↗
						</a>
						<button
							type="button"
							class="top-pill desktop-only"
							data-btn-download-md
							title="Obsidian互換のMarkdownファイルをダウンロード"
						>
							.md 保存
						</button>
						<button
							type="button"
							class="top-pill danger-pill desktop-only"
							data-btn-delete-open
							hidden
						>
							削除
						</button>
						<button type="button" class="save-cta" data-btn-save>
							公開アップロード
						</button>
					</div>
				</header>

				<!-- LOCAL DRAFT RECOVERY BANNER -->
				<div class="draft-banner" data-draft-banner hidden>
					<span>未アップロードの下書きがこの端末に残っています</span>
					<div class="draft-banner-actions">
						<button type="button" class="banner-btn primary" data-btn-restore-draft>
							復元
						</button>
						<button type="button" class="banner-btn" data-btn-discard-draft>
							破棄
						</button>
					</div>
				</div>

				<!-- PROPERTIES DRAWER (INLINE ON DESKTOP, NATIVE BOTTOM SHEET ON MOBILE) -->
				<div class="props-drawer" data-props-drawer hidden>
					<div class="props-sheet-head mobile-only">
						<div class="sheet-grabber" aria-hidden="true"></div>
						<div class="props-sheet-title-row">
							<strong>ノート設定・管理</strong>
							<button type="button" class="sheet-close-btn" data-btn-close-props>
								完了
							</button>
						</div>
					</div>

					<div class="props-grid">
						<!-- Mobile Public / Draft Switch inside Sheet -->
						<div class="prop-field prop-wide mobile-only-block">
							<span>公開ステータス</span>
							<div class="mobile-pub-segmented">
								<button
									type="button"
									class="seg-btn is-active"
									data-btn-set-pub="true"
								>
									🟢 公開 (Published)
								</button>
								<button
									type="button"
									class="seg-btn"
									data-btn-set-pub="false"
								>
									🟡 下書き (Draft)
								</button>
							</div>
						</div>

						<label class="prop-field">
							<span>SLUG (URL / ファイル名)</span>
							<input
								type="text"
								placeholder="2026-11-15"
								data-input-slug
								spellcheck="false"
							/>
						</label>
						<label class="prop-field">
							<span>DATE (公開日)</span>
							<input type="date" data-input-date />
						</label>
						<label class="prop-field">
							<span>TAGS (カンマ区切り)</span>
							<input
								type="text"
								placeholder="daily, thought, tech"
								data-input-tags
							/>
						</label>
						<label class="prop-field prop-wide">
							<span>DESCRIPTION (空欄なら本文先頭から自動生成)</span>
							<input
								type="text"
								placeholder="一覧に表示される短い要約（省略可）"
								data-input-desc
							/>
						</label>
						<div class="prop-field prop-wide">
							<span>HERO IMAGE (任意)</span>
							<div class="hero-input-row">
								<input
									type="text"
									placeholder="/uploads/2026/11/photo.webp"
									data-input-hero
								/>
								<button type="button" class="top-pill" data-btn-upload-hero>
									画像選択
								</button>
								<input
									type="file"
									accept="image/*"
									data-input-hero-file
									hidden
								/>
							</div>
						</div>

						<div class="prop-field prop-wide mobile-only-block">
							<span>ノート操作</span>
							<div class="mobile-sheet-actions">
								<a
									href="/blog"
									target="_blank"
									rel="noopener noreferrer"
									class="sheet-action-btn"
									data-link-open-live-mobile
									hidden
								>
									公開ページを開く ↗
								</a>
								<button
									type="button"
									class="sheet-action-btn"
									data-btn-download-md-mobile
								>
									.md ファイルを保存
								</button>
								<button
									type="button"
									class="sheet-action-btn danger"
									data-btn-delete-open-mobile
									hidden
								>
									このノートを削除…
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- DESKTOP FORMATTING RIBBON (HIDDEN ON MOBILE; MOBILE USES THUMB KEYBOARD BAR) -->
				<div class="desktop-ribbon-bar desktop-only" role="toolbar" aria-label="Markdown装飾ツールバー">
					<button type="button" class="fmt-btn" data-fmt="h2">H2</button>
					<button type="button" class="fmt-btn" data-fmt="h3">H3</button>
					<button type="button" class="fmt-btn" data-fmt="bold">B</button>
					<button type="button" class="fmt-btn" data-fmt="italic">I</button>
					<button type="button" class="fmt-btn" data-fmt="bullet">• List</button>
					<button type="button" class="fmt-btn" data-fmt="todo">☑ Todo</button>
					<button type="button" class="fmt-btn" data-fmt="quote">❝ Quote</button>
					<button type="button" class="fmt-btn" data-fmt="code">&lt;/&gt;</button>
					<button type="button" class="fmt-btn" data-fmt="link">🔗 Link</button>
					<button type="button" class="fmt-btn" data-fmt="hr">― HR</button>
					<button type="button" class="fmt-btn" data-fmt="time">🕒 時刻</button>
					<button type="button" class="fmt-btn accent-fmt" data-fmt="image">📷 画像追加</button>
				</div>

				<input
					type="file"
					accept="image/*"
					multiple
					data-input-image-file
					hidden
				/>

				<!-- UNIFIED SCROLLING DOCUMENT + SPLIT PREVIEW -->
				<div class="workspace-grid" data-workspace-grid data-mode="split">
					<div class="editor-pane" data-editor-scroll>
						<div class="doc-container">
							<textarea
								rows="1"
								class="inline-title-input"
								placeholder="無題の日誌（日付ノートは空欄でも自動補完）"
								data-input-title
							></textarea>
							<div class="cm-mount" data-cm-host></div>
						</div>
					</div>

					<div class="preview-pane" aria-label="ライブプレビュー">
						<div class="preview-inner">
							<p class="preview-meta" data-preview-meta></p>
							<h1 class="preview-title" data-preview-title></h1>
							<div class="prose preview-prose" data-preview-body></div>
						</div>
					</div>
				</div>

				<!-- DESKTOP FOOTER STATUS BAR -->
				<footer class="workspace-statusbar desktop-only">
					<div class="status-left">
						<span class="dirty-pill" data-dirty-status data-state="clean">READY</span>
						<span class="stats-text" data-editor-stats>0 文字 · 1 行</span>
					</div>
					<div class="status-right">
						<span class="shortcut-hint">
							/ でコマンド · ⌘S 保存 · ⌘E プレビュー
						</span>
						<span class="deploy-pill" data-deploy-status data-deploy="ready">READY</span>
					</div>
				</footer>

				<!-- MOBILE OBSIDIAN FORMATTING BAR (DOCKED IN THUMB ZONE IN EDIT MODE) -->
				<div
					class="mobile-Accessory-bar mobile-only"
					data-mobile-kb-bar
					role="toolbar"
					aria-label="モバイル入力ツールバー"
				>
					<div class="kb-scroll">
						<button type="button" class="kb-btn" data-fmt="todo">☑ Todo</button>
						<button type="button" class="kb-btn" data-fmt="bullet">• 箇条</button>
						<button type="button" class="kb-btn" data-fmt="h2">H2</button>
						<button type="button" class="kb-btn" data-fmt="h3">H3</button>
						<button type="button" class="kb-btn" data-fmt="bold">太字</button>
						<button type="button" class="kb-btn" data-fmt="time">🕒 時刻</button>
						<button type="button" class="kb-btn" data-fmt="image">📷 画像</button>
						<button type="button" class="kb-btn" data-fmt="hr">― 線</button>
						<button type="button" class="kb-btn" data-fmt="quote">❝ 引用</button>
						<button type="button" class="kb-btn" data-fmt="code">&lt;/&gt;</button>
						<button type="button" class="kb-btn" data-fmt="undo" aria-label="元に戻す">↶</button>
						<button type="button" class="kb-btn" data-fmt="redo" aria-label="やり直す">↷</button>
					</div>
					<button type="button" class="kb-done-btn" data-btn-kb-done hidden>
						完了 ⌄
					</button>
				</div>

				<!-- MOBILE ONE-THUMB BOTTOM TAB BAR -->
				<nav class="mobile-tabbar mobile-only" data-mobile-tabbar aria-label="モバイル操作バー">
					<button type="button" class="tab-item" data-btn-open-sidebar>
						<svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round" />
						</svg>
						<span class="tab-label">ノート一覧</span>
					</button>
					<button type="button" class="tab-item" data-btn-daily-mobile>
						<svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 5v14M5 12h14" stroke-linecap="round" />
						</svg>
						<span class="tab-label">今日の日誌</span>
					</button>
					<button type="button" class="tab-item" data-btn-mobile-preview>
						<svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" />
							<circle cx="12" cy="12" r="3" />
						</svg>
						<span class="tab-label" data-mobile-preview-label>プレビュー</span>
					</button>
					<button type="button" class="tab-item" data-btn-mobile-settings>
						<svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="3" />
							<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.08a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.08a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.08a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
						</svg>
						<span class="tab-label">設定・削除</span>
					</button>
					<button type="button" class="tab-item tab-save-primary" data-btn-save-mobile>
						<svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
							<path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<span class="tab-label" data-mobile-save-label>保存する</span>
					</button>
				</nav>
			</section>
		</div>

		<!-- AUTHENTICATION / VAULT CONNECTION OVERLAY -->
		<div class="modal-overlay" data-auth-overlay hidden>
			<div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
				<p class="sx-overline">SAIKATTYO STUDIO // VAULT AUTH</p>
				<h2 id="auth-modal-title">日誌エディタに接続</h2>
				<p class="modal-desc">
					PC・スマホのどちらからでも直接 <code>src/content/blog/*.md</code> の作成・編集・画像アップロード・削除を行えます。
				</p>

				<div class="auth-tabs">
					<button type="button" class="auth-tab is-active" data-auth-tab="github-token">
						GitHub Token (設定不要)
					</button>
					<button type="button" class="auth-tab" data-auth-tab="passphrase">
						Passphrase (合言葉)
					</button>
				</div>

				<form data-auth-form class="auth-form">
					<div data-field-token class="auth-field-group">
						<label class="prop-field">
							<span>GITHUB FINE-GRAINED PERSONAL ACCESS TOKEN</span>
							<input
								type="password"
								placeholder="github_pat_..."
								autocomplete="current-password"
								data-input-token
							/>
						</label>
						<p class="field-help">
							<a
								href="https://github.com/settings/personal-access-tokens/new"
								target="_blank"
								rel="noopener noreferrer"
							>
								GitHubでFine-grained tokenを発行 ↗
							</a>
							（Repository: <code>saikatty-site</code> のみ / Permissions: <code>Contents: Read and write</code>）。この端末内にのみ保存されます。
						</p>
					</div>

					<div data-field-passphrase class="auth-field-group" hidden>
						<label class="prop-field">
							<span>STUDIO PASSPHRASE</span>
							<input
								type="password"
								placeholder="Cloudflare Pagesに設定した合言葉"
								autocomplete="current-password"
								data-input-passphrase
							/>
						</label>
						<p class="field-help">
							Cloudflare Pages の環境変数に <code>GITHUB_TOKEN</code> と <code>STUDIO_PASSPHRASE</code> を設定すると短い合言葉だけで接続できます。
						</p>
					</div>

					<details class="repo-advanced">
						<summary>接続先リポジトリ詳細</summary>
						<div class="repo-advanced-grid">
							<label class="prop-field">
								<span>OWNER</span>
								<input type="text" value="saikattyo" data-input-owner />
							</label>
							<label class="prop-field">
								<span>REPO</span>
								<input type="text" value="saikatty-site" data-input-repo />
							</label>
							<label class="prop-field">
								<span>BRANCH</span>
								<input type="text" value="main" data-input-branch />
							</label>
						</div>
					</details>

					<p class="auth-error" data-auth-error hidden></p>

					<div class="modal-actions">
						<a href="/" class="top-pill">サイトへ戻る</a>
						<button type="submit" class="save-cta" data-auth-submit>
							VAULT に接続
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- SAFE DELETE CONFIRMATION MODAL -->
		<div class="modal-overlay" data-delete-modal hidden>
			<div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
				<p class="sx-overline">CONFIRM DELETION</p>
				<h2 id="delete-modal-title">このノートを削除しますか？</h2>
				<p class="modal-desc">
					対象: <strong data-delete-target></strong><br />
					Git履歴には残りますが、公開サイトおよびノート一覧から削除されます。削除前に手元へ <code>.md</code> 退避も可能です。
				</p>
				<div class="modal-actions">
					<button type="button" class="top-pill" data-btn-delete-backup>
						削除前に .md を退避保存
					</button>
					<div class="modal-actions-right">
						<button type="button" class="top-pill" data-btn-delete-cancel>
							キャンセル
						</button>
						<button type="button" class="danger-cta" data-btn-delete-confirm>
							完全に削除する
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- TOAST NOTIFICATION -->
		<div class="studio-toast" data-studio-toast role="status" aria-live="polite" hidden></div>

