---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="sx-post-main">
			<article>
				<header class="sx-post-header rise">
					<a class="sx-back" href="/blog">← JOURNAL</a>
					<div class="sx-date">
						<FormattedDate date={pubDate} />
						{updatedDate && <span>UPDATED <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1>{title}</h1>
					<p>{description}</p>
				</header>

				<div class="prose sx-post-prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.sx-post-main {
		width: min(760px, calc(100% - 64px));
	}

	.rise {
		animation: sx-fade-up 800ms var(--ease-sx) both;
	}

	.sx-post-header {
		padding: clamp(1.5rem, 4vw, 2.8rem) 0 2.2rem;
		border-bottom: 1px solid var(--line);
	}

	.sx-back {
		display: inline-block;
		margin-bottom: 1.6rem;
		color: var(--muted);
		font-family: var(--font-sx);
		font-size: 0.84rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-decoration: none;
	}

	.sx-back:hover {
		color: #ffffff;
	}

	.sx-date {
		display: flex;
		gap: 0.8rem;
		margin-bottom: 0.85rem;
		color: var(--muted);
		font-family: var(--font-sx);
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.sx-post-header h1 {
		font-family: var(--font-body);
		font-size: clamp(1.85rem, 4.2vw, 2.75rem);
		font-weight: 900;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.sx-post-header p {
		margin: 0;
		color: var(--muted);
		font-size: 0.98rem;
	}

	.sx-post-prose {
		padding-top: 2.6rem;
	}

	@media (max-width: 760px) {
		.sx-post-main {
			width: calc(100% - 40px);
		}
	}
</style>
