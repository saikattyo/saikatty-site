---
import { PROFILE } from '../consts';

const today = new Date();
const links = [
	{ href: PROFILE.x, label: 'X', external: true },
	{ href: PROFILE.github, label: 'GITHUB', external: true },
	{ href: PROFILE.linkedin, label: 'LINKEDIN', external: true },
	{ href: PROFILE.companyUrl, label: 'NANOFRONTIER', external: true },
	{ href: '/blog', label: 'JOURNAL', external: false },
	{ href: '/about', label: 'ABOUT', external: false },
];
---

<footer class="sx-footer">
	<div class="sx-footer-inner">
		<span class="sx-copy">SAIKATTYO &copy; {today.getFullYear()}</span>
		<div class="sx-footer-links" aria-label="フッターリンク">
			{links.map((item) => (
				<a
					href={item.href}
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					{item.label}
				</a>
			))}
		</div>
	</div>
</footer>

<style>
	.sx-footer {
		position: relative;
		z-index: 2;
		background: #000000;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.sx-footer-inner {
		width: min(var(--container), calc(100% - 64px));
		min-height: 88px;
		margin: 0 auto;
		padding: 1.5rem 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.2rem 2.4rem;
	}

	.sx-copy {
		color: var(--muted);
		font-family: var(--font-sx);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.sx-footer-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.9rem 2.2rem;
	}

	.sx-footer-links a {
		color: #ffffff;
		font-family: var(--font-sx);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.sx-footer-links a:hover {
		color: var(--muted);
	}
</style>
