---
interface Props {
	variant?: 'home' | 'compact';
}

const { variant = 'home' } = Astro.props;
---

<div class={`orbital-stage orbital-stage--${variant}`} data-orbital-stage data-variant={variant} aria-hidden="true">
	<canvas class="orbital-canvas" data-orbital-canvas></canvas>
	<div class="orbital-scrim"></div>

	{variant === 'home' && (
		<div class="orbital-callouts">
			<div class="callout-pin" data-callout="payload">
				<span class="reticle"></span>
				<span class="line"></span>
				<span class="tag">PAYLOAD // NANO-REACTOR</span>
			</div>
			<div class="callout-pin" data-callout="avionics">
				<span class="reticle"></span>
				<span class="line"></span>
				<span class="tag">INTERSTAGE // GRID FINS</span>
			</div>
			<div class="callout-pin" data-callout="propulsion">
				<span class="reticle"></span>
				<span class="line"></span>
				<span class="tag">AFT // 7x VECTOR ENGINES</span>
			</div>
		</div>
	)}
</div>

<script>
	const stages = document.querySelectorAll<HTMLElement>('[data-orbital-stage]');
	if (stages.length > 0) {
		import('../scripts/orbitalStage').then(({ initOrbitalStage }) => {
			stages.forEach((stage) => initOrbitalStage(stage));
		});
	}
</script>

<style>
	.orbital-stage {
		pointer-events: none;
		overflow: hidden;
		background: #020408;
	}

	.orbital-stage--home {
		position: fixed;
		inset: 0;
		z-index: 0;
	}

	.orbital-stage--compact {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.orbital-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Left-edge readability gradient for SpaceX stark white headlines while keeping right orbital craft crystal clear */
	.orbital-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(2, 4, 8, 0.78) 0%, rgba(2, 4, 8, 0.34) 44%, rgba(2, 4, 8, 0.04) 72%, rgba(2, 4, 8, 0.22) 100%),
			linear-gradient(180deg, rgba(2, 4, 8, 0.45) 0%, transparent 18%, transparent 78%, rgba(2, 4, 8, 0.85) 100%);
	}

	.orbital-callouts {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.callout-pin {
		position: absolute;
		top: 0;
		left: 0;
		display: inline-flex;
		align-items: center;
		opacity: 0;
		transition: opacity 260ms ease;
		will-change: transform, opacity;
	}

	.callout-pin.is-flipped {
		flex-direction: row-reverse;
	}

	.callout-pin.is-flipped .reticle {
		margin-left: 0;
		margin-right: -4.5px;
	}

	.callout-pin.is-flipped .line {
		background: linear-gradient(270deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.25));
	}

	.callout-pin .reticle {
		width: 9px;
		height: 9px;
		margin-left: -4.5px;
		margin-top: -4.5px;
		border: 1px solid #ffffff;
		background: rgba(56, 189, 248, 0.45);
		box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
	}

	.callout-pin .line {
		width: 28px;
		height: 1px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.25));
	}

	.callout-pin .tag {
		padding: 3px 7px;
		border: 1px solid rgba(255, 255, 255, 0.24);
		background: rgba(2, 4, 8, 0.78);
		color: rgba(255, 255, 255, 0.88);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		white-space: nowrap;
		backdrop-filter: blur(6px);
	}

	@media (max-width: 860px) {
		.orbital-scrim {
			background:
				linear-gradient(180deg, rgba(2, 4, 8, 0.35) 0%, rgba(2, 4, 8, 0.08) 28%, rgba(2, 4, 8, 0.78) 64%, rgba(2, 4, 8, 0.94) 100%);
		}

		.orbital-callouts {
			display: none;
		}
	}
</style>
