---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NanoStage from '../components/NanoStage.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedBlogPosts, postSlug } from '../lib/blog';

const allPosts = await getPublishedBlogPosts();
const latestPosts = allPosts.slice(0, 5);

const postThemes: Record<string, string> = {
	'1': 'THOUGHT',
	'2': 'PRODUCT',
	'3': 'REVIEW',
	'4': 'MISSION',
	'5': 'MISSION',
	'6': 'PORTRAIT',
	'7': 'WORKFLOW',
	'8': 'WORKFLOW',
};

const specMetrics = [
	{ value: '2025.04', unit: 'LAUNCH', label: 'NANOFRONTIER CO-FOUNDED' },
	{ value: '10¹ NM', unit: 'SCALE', label: 'ORGANIC NANOPARTICLE CONTROL' },
	{ value: '02 HUBS', unit: 'LINK', label: 'TOKYO ⇄ SENDAI R&D CORRIDOR' },
	{ value: String(allPosts.length).padStart(2, '0'), unit: 'LOGS', label: 'PUBLIC TRANSMISSIONS' },
];

const payloadSpecs = [
	{
		code: 'SYS-01 // PRIMARY PAYLOAD',
		mode: 'payload',
		title: 'NanoFrontier',
		classification: 'CO-FOUNDER · DEEPTECH',
		body: '東北大学発の独自ナノ粒子化技術で、水中PFASのリアルタイム検出・次世代レドックスフロー蓄電池・高効率冷却液などの社会実装を推進。研究室の科学と産業スケールを直結させる。',
		href: PROFILE.companyUrl,
	},
	{
		code: 'SYS-02 // PROPULSION VECTOR',
		mode: 'burn',
		title: '資源がなめらかに循環する社会',
		classification: 'ENERGY · CIVILIZATION',
		body: '一部の人間しか触れられない高コストな先端技術ではなく、誰もがアクセスできる圧倒的低コストな仕組みとして商業化し、後世に続く人類の繁栄基盤を築く。',
	},
	{
		code: 'SYS-03 // AVIONICS & CRAFT',
		mode: 'orbit',
		title: 'Software × AI × Field Notes',
		classification: 'TOKYO // SENDAI',
		body: '仙台の研究開発拠点と東京を往復しながら、フルスタック開発・AIエージェント活用・日々の思考の断片をこのミッションログに記録している。',
	},
];

const flightStages = [
	{
		stage: 'STAGE 01',
		period: '〜2019',
		title: '鳥取大学工学部',
		role: 'ENGINEERING ORIGIN',
		note: '在学中からアプリ・SaaS開発チームを牽引し、ソフトウェア実装の基礎を確立。',
	},
	{
		stage: 'STAGE 02',
		period: 'DeNA',
		title: 'Anyca',
		role: 'FULL-STACK & PDM',
		note: 'iOS / Android / サーバー設計からプロダクトマネジメント・採用まで全方位を推進。',
	},
	{
		stage: 'STAGE 03',
		period: 'CATALIS',
		title: 'AI Applications',
		role: 'VENTURE BUILDING',
		note: 'AIアプリケーション開発と新規事業づくりを横断し、技術から事業への変換速度を磨く。',
	},
	{
		stage: 'STAGE 04',
		period: '2025〜',
		title: 'NanoFrontier',
		role: 'CO-FOUNDER // IN ORBIT',
		note: '東北大学発ナノ粒子化技術の社会実装へ。環境・エネルギー・医療領域へ展開中。',
		active: true,
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/profile_image.jpg" />
	</head>
	<body>
		<NanoStage variant="home" />
		<Header />

		<main class="flight-deck">
			<!-- SECTION 00: FULL-VIEWPORT ORBITAL HERO -->
			<section class="hero-deck" data-orbital-drag aria-label="ミッション概要と3D宇宙機ステージ">
				<div class="hero-orbital-spacer" aria-hidden="true"></div>

				<div class="hero-content rise">
					<p class="kicker">MISSION // NFR-01 · KATSUYA SAITO</p>
					<p class="hero-callsign">{PROFILE.handle.toUpperCase()}</p>
					<h1>思考を掃き溜めて、<br />次の社会実装へ。</h1>
					<p class="hero-lead">
						{PROFILE.name} — 東北大学発 <strong>{PROFILE.company}</strong> 共同創業者。
						ナノ粒子、エネルギー、ソフトウェア、日々の違和感を軌道上から記録する個人ミッションアーカイブ。
					</p>
					<div class="hero-cta">
						<a class="button primary" href="/blog">TRANSMISSIONS // 記事一覧</a>
						<a class="button secondary" href="/about">MISSION DOSSIER // 経歴</a>
					</div>
				</div>

				<!-- SpaceX Bottom Mission Control Telemetry & Hardware Dock -->
				<div class="mission-dock" role="region" aria-label="3D宇宙機テレメトリおよび制御コンソール">
					<div class="telemetry-strip">
						<div class="tel-cell status-cell">
							<span class="tel-key">SYSTEM STATUS</span>
							<span class="tel-val accent" data-stage-status>INITIALIZING ORBITAL GLB...</span>
						</div>
						<div class="tel-cell">
							<span class="tel-key">ALTITUDE (LEO)</span>
							<span class="tel-val" data-telemetry-alt>418.2 KM</span>
						</div>
						<div class="tel-cell">
							<span class="tel-key">ORBITAL VELOCITY</span>
							<span class="tel-val" data-telemetry-vel>27,614 KM/H</span>
						</div>
						<div class="tel-cell">
							<span class="tel-key">ATTITUDE // DRAG 360°</span>
							<span class="tel-val" data-telemetry-att>P +16° / Y 328°</span>
						</div>
					</div>

					<div class="dock-controls-row">
						<span class="flight-caption" data-flight-caption>
							LEO ORBITAL CRUISE // 地球低軌道巡航・姿勢制御中
						</span>
						<div class="flight-buttons" role="toolbar" aria-label="3D宇宙機フライトモード切替">
							<button type="button" class="ctrl-btn is-active" data-flight-mode="orbit" aria-pressed="true">
								01 ORBIT
							</button>
							<button type="button" class="ctrl-btn" data-flight-mode="payload" aria-pressed="false">
								02 PAYLOAD
							</button>
							<button type="button" class="ctrl-btn burn-btn" data-flight-mode="burn" aria-pressed="false">
								03 STATIC FIRE
							</button>
							<button type="button" class="ctrl-btn" data-flight-mode="xray" aria-pressed="false">
								04 CAD X-RAY
							</button>
							<button type="button" class="ctrl-btn sep-btn" data-stage-sep aria-pressed="false">
								[ STAGE SEP ]
							</button>
						</div>
					</div>
				</div>
			</section>

			<!-- ARCHITECTURAL TELEMETRY METRICS -->
			<section class="spec-strip" aria-label="主要指標">
				{specMetrics.map((m) => (
					<div class="spec-cell">
						<div class="spec-top">
							<span class="spec-num">{m.value}</span>
							<span class="spec-unit">{m.unit}</span>
						</div>
						<span class="spec-label">{m.label}</span>
					</div>
				))}
			</section>

			<!-- SECTION 01: ACTIVE PAYLOAD (LEFT-FRAMED SO 3D FAIRING DEPLOYMENT SHINES ON RIGHT) -->
			<section class="mission-section payload-section" aria-labelledby="payload-title">
				<div class="section-head">
					<p class="kicker">01 // ACTIVE PAYLOAD</p>
					<h2 id="payload-title">いまの立ち位置</h2>
					<p class="section-sub">
						肩書きではなく、現在軌道に乗せている事業と技術領域。各モジュールに触れると右方の3D機体システムが連動します。
					</p>
				</div>

				<div class="payload-stack">
					{payloadSpecs.map((item) => (
						<article class="payload-card" data-sync-flight={item.mode}>
							<span class="crosshair tl" aria-hidden="true">+</span>
							<span class="crosshair tr" aria-hidden="true">+</span>
							<div class="payload-meta">
								<span class="payload-code">{item.code}</span>
								<span class="payload-class">{item.classification}</span>
							</div>
							<h3>
								{item.href ? (
									<a href={item.href} target="_blank" rel="noopener noreferrer">
										{item.title} <span class="ext">↗</span>
									</a>
								) : (
									item.title
								)}
							</h3>
							<p>{item.body}</p>
						</article>
					))}
				</div>
			</section>

			<!-- SECTION 02: MULTI-STAGE FLIGHT HERITAGE -->
			<section class="mission-section heritage-section" aria-labelledby="heritage-title">
				<div class="section-head wide">
					<div>
						<p class="kicker">02 // FLIGHT HERITAGE</p>
						<h2 id="heritage-title">ここまでの軌道</h2>
					</div>
					<p class="section-sub">
						ソフトウェアエンジニアリングからプロダクトマネジメント、AI事業開発を経て、ディープテックの社会実装へ至る4段のステージ。
					</p>
				</div>

				<ol class="stage-grid">
					{flightStages.map((s) => (
						<li class:list={['stage-card', { 'is-active': s.active }]}>
							<div class="stage-header">
								<span class="stage-num">{s.stage}</span>
								<span class="stage-period">{s.period}</span>
							</div>
							<strong class="stage-title">{s.title}</strong>
							<span class="stage-role">{s.role}</span>
							<p class="stage-note">{s.note}</p>
						</li>
					))}
				</ol>
			</section>

			<!-- SECTION 03: MISSION TRANSMISSIONS (LAUNCH MANIFEST TABLE) -->
			<section class="mission-section manifest-section" aria-labelledby="manifest-title">
				<div class="section-head wide">
					<div>
						<p class="kicker">03 // MISSION TRANSMISSIONS</p>
						<h2 id="manifest-title">最近の記録</h2>
					</div>
					<p class="section-sub">
						思考の断片、クラフトの試行錯誤、人類の繁栄に関するフィールドノート。
					</p>
				</div>

				<div class="manifest-table">
					<div class="manifest-thead" aria-hidden="true">
						<span>FLIGHT</span>
						<span>DATE (JST)</span>
						<span>CLASS</span>
						<span>TRANSMISSION</span>
						<span>ACTION</span>
					</div>

					{latestPosts.map((post, idx) => {
						const slug = postSlug(post);
						const flightNo = `FLT-${String(allPosts.length - idx).padStart(2, '0')}`;
						return (
							<article class="manifest-row">
								<a href={`/blog/${slug}`} class="manifest-link">
									<span class="col-flight">{flightNo}</span>
									<span class="col-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="col-class">{postThemes[slug] || 'NOTE'}</span>
									<div class="col-main">
										<h3>{post.data.title}</h3>
										<p>{post.data.description || '日々の思考を書き留めた投稿です。'}</p>
									</div>
									<span class="col-action">READ →</span>
								</a>
							</article>
						);
					})}
				</div>

				<div class="manifest-footer">
					<a class="button secondary" href="/blog">ALL TRANSMISSIONS // 全記事一覧 →</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	const syncCards = document.querySelectorAll<HTMLElement>('[data-sync-flight]');
	syncCards.forEach((card) => {
		card.addEventListener('mouseenter', () => {
			const mode = card.dataset.syncFlight;
			if (!mode) return;
			const btn = document.querySelector<HTMLButtonElement>(`[data-flight-mode="${mode}"]`);
			btn?.click();
		});
	});
</script>

<style>
	.flight-deck {
		width: min(var(--container), calc(100% - 48px));
		margin: 0 auto;
		padding: 0 0 96px;
	}

	.rise {
		animation: sx-rise 850ms var(--ease-sx) both;
	}

	/* SECTION 00: FULL-BLEED ORBITAL HERO */
	.hero-deck {
		min-height: calc(100svh - 70px);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(2.4rem, 6vh, 4.8rem) 0 1.4rem;
		cursor: grab;
		user-select: none;
	}

	.hero-deck.is-dragging {
		cursor: grabbing;
	}

	.hero-orbital-spacer {
		display: none;
	}

	.hero-content {
		max-width: 610px;
		margin: auto 0;
		padding: 1rem 0 2rem;
	}

	.hero-callsign {
		margin: 0 0 0.55rem;
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 7.2vw, 6.4rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		line-height: 0.92;
		color: #ffffff;
		text-transform: uppercase;
	}

	.hero-content h1 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.85rem, 3.6vw, 2.85rem);
		font-weight: 700;
		line-height: 1.26;
		letter-spacing: -0.01em;
	}

	.hero-lead {
		max-width: 520px;
		margin: 0;
		color: rgba(226, 234, 244, 0.82);
		font-size: 0.98rem;
		line-height: 1.8;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 2.1rem;
	}

	/* MISSION CONTROL DOCK */
	.mission-dock {
		border: 1px solid var(--line);
		background: rgba(3, 6, 12, 0.78);
		backdrop-filter: blur(18px);
	}

	.telemetry-strip {
		display: grid;
		grid-template-columns: 1.35fr 1fr 1fr 1.1fr;
		border-bottom: 1px solid var(--line-subtle);
	}

	.tel-cell {
		padding: 0.68rem 1rem;
		border-right: 1px solid var(--line-subtle);
		display: flex;
		flex-direction: column;
		gap: 0.18rem;
	}

	.tel-cell:last-child {
		border-right: 0;
	}

	.tel-key {
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.16em;
	}

	.tel-val {
		color: #ffffff;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.tel-val.accent {
		color: var(--accent);
	}

	.dock-controls-row {
		padding: 0.65rem 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
	}

	.flight-caption {
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.flight-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.ctrl-btn {
		padding: 0.46rem 0.82rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 0;
		background: transparent;
		color: rgba(255, 255, 255, 0.76);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		cursor: pointer;
		transition:
			background 180ms ease,
			color 180ms ease,
			border-color 180ms ease;
	}

	.ctrl-btn:hover {
		border-color: #ffffff;
		color: #ffffff;
	}

	.ctrl-btn.is-active {
		background: #ffffff;
		border-color: #ffffff;
		color: #000000;
	}

	.ctrl-btn.burn-btn.is-active {
		background: var(--burn);
		border-color: var(--burn);
		color: #000000;
	}

	.ctrl-btn.sep-btn {
		border-color: rgba(56, 189, 248, 0.5);
		color: var(--accent);
	}

	.ctrl-btn.sep-btn.is-active {
		background: var(--accent);
		border-color: var(--accent);
		color: #000000;
	}

	/* TELEMETRY COUNTER STRIP */
	.spec-strip {
		margin-top: 2.5rem;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: rgba(3, 6, 12, 0.68);
		backdrop-filter: blur(12px);
	}

	.spec-cell {
		padding: 1.65rem 1.4rem;
		border-right: 1px solid var(--line-subtle);
	}

	.spec-cell:last-child {
		border-right: 0;
	}

	.spec-top {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin-bottom: 0.4rem;
	}

	.spec-num {
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.03em;
		color: #ffffff;
	}

	.spec-unit {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
	}

	.spec-label {
		display: block;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
	}

	/* MISSION SECTIONS */
	.mission-section {
		padding: clamp(5rem, 10vw, 8.5rem) 0 0;
	}

	.section-head {
		max-width: 620px;
		margin-bottom: 2.4rem;
	}

	.section-head.wide {
		max-width: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.75fr);
		gap: 1.5rem 3rem;
		align-items: end;
	}

	.section-head h2 {
		margin-bottom: 0.6rem;
	}

	.section-head.wide h2 {
		margin-bottom: 0;
	}

	.section-sub {
		margin: 0;
		color: var(--muted);
		font-size: 0.96rem;
	}

	/* PAYLOAD CARDS (LEFT COLUMN SO 3D CRAFT REMAINS VISIBLE ON RIGHT) */
	.payload-stack {
		max-width: 650px;
		display: grid;
		gap: 1rem;
	}

	.payload-card {
		position: relative;
		padding: 1.7rem 1.75rem;
		border: 1px solid var(--line);
		background: var(--bg-panel);
		backdrop-filter: blur(18px);
		transition:
			border-color 220ms ease,
			background 220ms ease,
			transform 220ms var(--ease-sx);
	}

	.payload-card:hover {
		border-color: rgba(255, 255, 255, 0.65);
		background: rgba(8, 14, 26, 0.9);
		transform: translateX(6px);
	}

	.crosshair {
		position: absolute;
		color: rgba(255, 255, 255, 0.35);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1;
		pointer-events: none;
	}

	.crosshair.tl {
		top: 8px;
		left: 10px;
	}

	.crosshair.tr {
		top: 8px;
		right: 10px;
	}

	.payload-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
		padding-top: 0.25rem;
	}

	.payload-code {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
	}

	.payload-class {
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
	}

	.payload-card h3 {
		margin-bottom: 0.65rem;
		font-size: clamp(1.3rem, 2.2vw, 1.65rem);
	}

	.payload-card h3 a {
		text-decoration: none;
	}

	.ext {
		color: var(--accent);
		font-size: 0.9em;
	}

	.payload-card p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	/* STAGE TIMELINE */
	.stage-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--line);
		background: var(--bg-panel);
		backdrop-filter: blur(18px);
	}

	.stage-card {
		padding: 1.7rem 1.45rem;
		border-right: 1px solid var(--line);
		display: flex;
		flex-direction: column;
	}

	.stage-card:last-child {
		border-right: 0;
	}

	.stage-card.is-active {
		background: linear-gradient(180deg, rgba(56, 189, 248, 0.14) 0%, rgba(4, 8, 15, 0.4) 100%);
		box-shadow: inset 0 2px 0 #ffffff;
	}

	.stage-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
	}

	.stage-num {
		color: #ffffff;
		font-weight: 600;
	}

	.stage-period {
		color: var(--accent);
	}

	.stage-title {
		display: block;
		margin-bottom: 0.25rem;
		font-size: 1.3rem;
	}

	.stage-role {
		display: block;
