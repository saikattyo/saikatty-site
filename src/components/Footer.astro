---
const today = new Date();
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Journal' },
	{ href: '/about', label: 'About' },
];
---

<footer class="site-footer">
	<div class="footer-shell">
		<div class="footer-copy">
			<p class="eyebrow">Saikattyoの掃き溜め</p>
			<h2>雑多な思考を、読み返せる形に。</h2>
			<p>技術、仕事、日々の違和感、これからの社会のこと。ばらばらなメモをひとつの場所に残しています。</p>
		</div>
		<div class="footer-links" aria-label="フッターナビゲーション">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
		<div class="social-links">
			<a href="https://x.com/katsuyakat" target="_blank" rel="noopener noreferrer">X</a>
			<a href="https://github.com/saikattyo" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://www.linkedin.com/in/saito-katsuya-842b37296/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} Katsuya Saito</span>
		<span>Built with curiosity.</span>
	</div>
</footer>

<style>
	.site-footer {
		width: min(var(--container), calc(100% - 40px));
		margin: 0 auto 28px;
		padding: 34px;
		border: 1px solid rgba(255, 250, 241, 0.18);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(circle at 20% 15%, rgba(217, 164, 65, 0.28), transparent 26rem),
			linear-gradient(135deg, #17130d, #2a2118 58%, #1f3f43);
		color: var(--bg-soft);
		box-shadow: var(--shadow);
	}

	.footer-shell {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) auto auto;
		gap: 2rem;
		align-items: end;
	}

	.eyebrow {
		margin-bottom: 0.8rem;
		color: rgba(255, 250, 241, 0.62);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.footer-copy h2 {
		max-width: 680px;
		margin-bottom: 1rem;
		color: var(--bg-soft);
		font-size: clamp(2rem, 4vw, 4.5rem);
	}

	.footer-copy p:last-child {
		max-width: 620px;
		margin: 0;
		color: rgba(255, 250, 241, 0.72);
	}

	.footer-links,
	.social-links {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-links a,
	.social-links a {
		color: rgba(255, 250, 241, 0.76);
		font-weight: 700;
		text-decoration: none;
	}

	.footer-links a:hover,
	.social-links a:hover {
		color: var(--bg-soft);
	}

	.footer-bottom {
		margin-top: 2.5rem;
		padding-top: 1rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid rgba(255, 250, 241, 0.14);
		color: rgba(255, 250, 241, 0.58);
		font-size: 0.9rem;
	}

	@media (max-width: 780px) {
		.site-footer {
			width: min(100% - 28px, var(--container));
			padding: 24px;
		}

		.footer-shell {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.footer-links,
		.social-links {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.footer-bottom {
			flex-direction: column;
		}
	}
</style>
