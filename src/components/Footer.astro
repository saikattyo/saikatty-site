---
import { PROFILE, SITE_TITLE } from '../consts';

const today = new Date();
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Journal' },
	{ href: '/about', label: 'About' },
];
const socials = [
	{ href: PROFILE.x, label: 'X' },
	{ href: PROFILE.github, label: 'GitHub' },
	{ href: PROFILE.linkedin, label: 'LinkedIn' },
	{ href: PROFILE.companyUrl, label: 'NanoFrontier' },
];
---

<footer class="site-footer">
	<div class="footer-shell">
		<div class="footer-copy">
			<p class="eyebrow">{SITE_TITLE} // PERSONAL ARCHIVE</p>
			<h2>思考を掃き溜めて、次の一手に変える。</h2>
			<p>
				{PROFILE.name} / {PROFILE.handle}。{PROFILE.company}の共同創業者として、ナノ粒子と社会実装のあいだを行き来しながら書いています。
			</p>
		</div>
		<div class="footer-links" aria-label="フッターナビゲーション">
			<span class="col-label">Index</span>
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
		<div class="social-links">
			<span class="col-label">Network</span>
			{socials.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer">
					{link.label} ↗
				</a>
			))}
		</div>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} {PROFILE.name}</span>
		<span class="mono">35.6762°N TOKYO / 38.2682°N SENDAI</span>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 2;
		width: min(var(--container), calc(100% - 40px));
		margin: 0 auto 32px;
		padding: clamp(28px, 4vw, 42px);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(circle at 14% 0%, rgba(94, 234, 212, 0.14), transparent 44%),
			linear-gradient(155deg, rgba(11, 18, 29, 0.92) 0%, rgba(6, 10, 17, 0.96) 100%);
		box-shadow: var(--shadow);
		backdrop-filter: blur(20px);
	}

	.footer-shell {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) auto auto;
		gap: 2.4rem;
		align-items: start;
	}

	.eyebrow {
		margin-bottom: 0.85rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.footer-copy h2 {
		max-width: 660px;
		margin-bottom: 1rem;
		color: var(--ink);
		font-size: clamp(1.75rem, 3.6vw, 3rem);
	}

	.footer-copy p:last-child {
		max-width: 600px;
		margin: 0;
		color: var(--muted);
	}

	.col-label {
		margin-bottom: 0.35rem;
		color: var(--dim);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.footer-links,
	.social-links {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.footer-links a,
	.social-links a {
		color: #cbd5e1;
		font-family: var(--font-brand);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}

	.footer-links a:hover,
	.social-links a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		margin-top: 2.4rem;
		padding-top: 1.1rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid var(--line);
		color: var(--dim);
		font-size: 0.85rem;
	}

	.mono {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
	}

	@media (max-width: 780px) {
		.site-footer {
			width: min(100% - 28px, var(--container));
			padding: 24px;
		}

		.footer-shell {
			grid-template-columns: 1fr;
			gap: 1.6rem;
		}

		.footer-links,
		.social-links {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.75rem 1.15rem;
		}

		.col-label {
			width: 100%;
			margin-bottom: -0.25rem;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
